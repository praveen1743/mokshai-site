---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import CtaBand from '../../components/CtaBand.astro';
import { breadcrumbs } from '../../lib/schema';
const posts = (await getCollection('insights')).sort((a, b) => +b.data.updated - +a.data.updated);
const fmt = (d: Date) => d.toLocaleDateString('en-US', { day: 'numeric', month: 'short', year: 'numeric' });
---
<Base title="Insights on AI Agents & Automation" description="Practical writing on AI agents for MSPs, back-office automation and AI strategy from the Moksh AI team." schema={[{ '@type': 'CollectionPage', name: 'Insights', url: 'https://mokshai.net/insights/' }, breadcrumbs([{ name: 'Insights', path: '/insights/' }])]}>
  <PageHero eyebrow="Insights" title="Notes from the work" lede="Practical writing on AI agents, automation and the decisions around them. No trend pieces." />
  <section class="section">
    <div class="container list">
      {posts.map((p) => (
        <a class="post" href={`/${p.id}/`}>
          <div class="meta"><span class="tag">{p.data.audience === 'msp' ? 'For MSPs' : 'For operations'}</span><time class="mono" datetime={p.data.updated.toISOString()}>Updated {fmt(p.data.updated)}</time></div>
          <h2>{p.data.title}</h2>
          <p>{p.data.summary}</p>
          <span class="link-arrow">Read</span>
        </a>
      ))}
    </div>
  </section>
  <CtaBand />
</Base>
<style>
  .list { border-top: 1px solid var(--line); }
  .post { display: grid; grid-template-columns: minmax(0, .5fr) minmax(0, 1fr); grid-template-areas: 'meta title' 'meta text' 'meta link'; gap: 10px 48px; padding-block: 36px; border-bottom: 1px solid var(--line); color: inherit; text-decoration: none; }
  .meta { grid-area: meta; display: grid; gap: 6px; align-content: start; font-size: var(--t-xs); color: var(--muted); }
  .post h2 { grid-area: title; font-size: var(--t-xl); transition: color .18s var(--ease); }
  .post:hover h2 { color: var(--blue-700); }
  .post p { grid-area: text; color: var(--muted); max-width: 64ch; }
  .post .link-arrow { grid-area: link; color: var(--blue-700); }
  @media (max-width: 800px) { .post { grid-template-columns: minmax(0, 1fr); grid-template-areas: 'meta' 'title' 'text' 'link'; } }
</style>
