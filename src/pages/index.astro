  .cap-go { font-size: var(--t-sm); }
  .sr { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }
  /* once the ring is live, only the front card's caption shows, stacked in one cell */
  .captions.live { grid-template-areas: "c"; }
  .captions.live .caption { grid-area: c; opacity: 0; visibility: hidden; transform: translateY(8px); transition: opacity .35s var(--ease), transform .35s var(--ease), visibility 0s linear .35s; }
  .captions.live .caption.on { opacity: 1; visibility: visible; transform: none; transition: opacity .3s var(--ease), transform .3s var(--ease), visibility 0s; }

  /* silence */
  .hush { display: grid; place-items: center; min-height: 62vh; padding: 0 24px; text-align: center; }
  .hush p { font: italic 400 clamp(2rem, 1rem + 4vw, 4.6rem)/1.1 var(--f-display); color: var(--ink); opacity: var(--o, 1); }

  /* 4 gate */
  .gate-pin { display: grid; align-items: center; padding-block: clamp(56px, 7vw, 96px); }
  :global(html.motion) .gate-pin { padding-block: 92px 16px; }
  .gate { display: grid; gap: clamp(16px, 2.6vh, 30px); }
  .gate-head { display: grid; gap: 12px; max-width: 900px; }
  .gate-head h2 { font-size: clamp(1.8rem, 1.2rem + 2vw, 2.9rem); }
  :global(html.motion) .gate-head .lede { font-size: var(--t-md); }
  .board { display: grid; grid-template-columns: minmax(0, .75fr) minmax(0, 1.15fr) minmax(0, 1.25fr); gap: clamp(12px, 1.6vw, 22px); align-items: stretch; }
  .quote { position: relative; display: flex; flex-direction: column; gap: 2px; background: linear-gradient(180deg, #dfe8f1, #c6d4e2); color: #0e2036; border-radius: 16px; padding: 22px; font-size: var(--t-xs); }
  .q-title { font: 500 1.4rem/1.2 var(--f-display); color: #0b1b2e; margin-bottom: 10px; }
  .quote .row { display: flex; justify-content: space-between; gap: 8px; padding: 7px 0; border-bottom: 1px solid rgba(14, 32, 54, .15); }
