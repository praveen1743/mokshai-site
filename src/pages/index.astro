  .phase:nth-child(1) { --i: 0; } .phase:nth-child(2) { --i: 1; } .phase:nth-child(3) { --i: 2; }
  .phase h3 { font-size: clamp(1.8rem, 1.2rem + 2vw, 3rem); font-weight: 420; margin-bottom: 10px; }
  .phase p { color: var(--muted); }
  .phase dl { margin: 0; border-left: 2px solid var(--green); padding-left: 16px; }
  .phase dt { font-size: var(--t-xs); color: var(--muted); letter-spacing: .06em; text-transform: uppercase; }
  .phase dd { margin: 6px 0 0; font: 450 1.3rem/1.3 var(--f-display); }
  .after-steps { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 16px; align-items: center; margin-top: clamp(24px, 4vw, 40px); color: var(--muted); }

  /* 9 why */
  .why { display: grid; grid-template-columns: minmax(0, .9fr) minmax(0, 1.1fr); gap: clamp(28px, 6vw, 80px); }
  .why-head h2 { margin: 10px 0 24px; }
