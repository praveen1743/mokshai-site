  /* short screens: drop the lede while pinned so the ring and caption still fit */
  @media (max-height: 700px) { :global(html.path-pinned) .path-head .lede { display: none; } :global(html.path-pinned) .ring { height: clamp(200px, calc(100svh - 330px), 470px); } }
  /* full bleed: the ring runs edge to edge, its top and bottom fade into the page */
  .ring { width: 100vw; margin-inline: calc(50% - 50vw); height: clamp(200px, calc(100svh - 440px), 470px);
    -webkit-mask-image: linear-gradient(180deg, transparent 0, #000 9%, #000 91%, transparent 100%);
    mask-image: linear-gradient(180deg, transparent 0, #000 9%, #000 91%, transparent 100%); }
  .captions { list-style: none; margin: 0; padding: 0; display: grid; gap: 22px; width: 100%; max-width: 640px; }
