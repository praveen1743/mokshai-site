    }
  }
  @keyframes deal { from { transform: translateY(60px) rotate(2deg); } to { transform: none; } }
  @keyframes draw { from { transform: translateX(-28px); } to { transform: none; } }

  @media (max-width: 980px) {
    .hero-copy > * { max-width: 100%; }
    .docs { right: -14%; top: 4%; width: 60vw; opacity: .3; }
    .p-far, .p-fore { display: none; }
    .work-grid, .why, .faq-grid, .ind-grid { grid-template-columns: minmax(0, 1fr); }
    .board { grid-template-columns: minmax(0, 1fr); }
    .quote { display: none; }
    .agent-grid { grid-template-columns: minmax(0, 1fr); }
    .svc-list, .ind-list { grid-template-columns: minmax(0, 1fr); }
