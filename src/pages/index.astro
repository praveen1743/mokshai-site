  .steps li::before { content: ""; display: block; width: 32px; height: 32px; margin: 0 auto 8px; border-radius: 50%; background: var(--paper); border: 2px solid var(--line-strong); transition: background-color .4s var(--ease), border-color .4s var(--ease); }
  .steps li.g::before { border-radius: 9px; }
  .steps li.on { color: var(--ink); }
  .steps li.on::before { background: var(--blue); border-color: var(--blue); }
  .steps li.hold::before { background: var(--paper); border-color: var(--amber-on-dark); animation: ring 1.6s infinite; }
  .steps li.done::before { background: var(--green); border-color: var(--green); }
  @keyframes ring { from { box-shadow: 0 0 0 0 rgba(242, 180, 92, .55); } to { box-shadow: 0 0 0 16px rgba(242, 180, 92, 0); } }
  .status { min-height: 3.2em; font: 450 clamp(1.25rem, 1rem + .8vw, 1.8rem)/1.2 var(--f-display); }
  .status :global(small) { display: block; font: 400 var(--t-sm)/1.45 var(--f-body); color: var(--muted); margin-top: 6px; }
  .btn-person { align-self: flex-start; background: var(--amber-on-dark); color: #1a1204; }
