  .ind-feature:hover { color: var(--ink); border-color: var(--green-on-dark); }
  .tag { font: 500 var(--t-xs)/1 var(--f-mono); color: var(--green-on-dark); letter-spacing: .06em; text-transform: uppercase; }
  .if-title { font: 450 clamp(1.6rem, 1.2rem + 1.2vw, 2.3rem)/1.06 var(--f-display); }
  .if-text { color: var(--on-dark-muted); font-size: var(--t-sm); }
