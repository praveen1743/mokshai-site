  .faq-grid { display: grid; grid-template-columns: minmax(0, .7fr) minmax(0, 1.3fr); gap: clamp(28px, 6vw, 80px); align-items: start; }

  /* scroll-linked motion for the still sections: transforms only, never opacity */
  @supports (animation-timeline: view()) {
