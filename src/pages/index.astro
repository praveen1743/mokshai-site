  .why-facts div { display: grid; grid-template-columns: 110px minmax(0, 1fr); gap: 12px; padding-bottom: 12px; border-bottom: 1px solid var(--line); }
  .why-facts dt { font-size: var(--t-xs); color: var(--muted); text-transform: uppercase; letter-spacing: .06em; padding-top: 3px; }
  .why-facts dd { margin: 0; }
  .why-list { list-style: none; margin: 0; padding: 0; }
  .why-list li { display: grid; grid-template-columns: 40px minmax(0, 1fr); gap: 12px; padding: 18px 0; border-top: 1px solid var(--line); }
  .why-list li > .mono { color: var(--green-on-dark); font-size: var(--t-xs); padding-top: 6px; }
  .why-list p { color: var(--muted); font-size: var(--t-sm); margin-top: 4px; }

