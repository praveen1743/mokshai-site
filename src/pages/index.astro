---
import Base from '../layouts/Base.astro';
import Arrow from '../components/Arrow.astro';
import Icon from '../components/Icon.astro';
import HeroRender from '../components/hero/HeroRender.astro';
import Faq from '../components/Faq.astro';
import CtaBand from '../components/CtaBand.astro';
import FounderVideo from '../components/FounderVideo.astro';
import MiniCalc from '../components/MiniCalc.astro';
import AgentCard from '../components/agents/AgentCard.astro';
import { introVideo } from '../lib/introVideo';
import { services, site } from '../site.config';
import { agents } from '../lib/agents';
import { industries } from '../lib/industries';
import { tools } from '../lib/tools';
import { faq, videoObject } from '../lib/schema';

// One agent each from healthcare, finance and legal; the rest live on /agents/.
const homeAgents = ['medical-report-insights', 'financial-reasoning', 'legal-document-review'].map((slug) => agents.find((a) => a.slug === slug)!);

// Manufacturing gets the featured panel: Moksh Group's longest experience.
const manufacturing = industries.find((i) => i.slug === 'manufacturing')!;
const otherIndustries = industries.filter((i) => i.slug !== 'manufacturing');

const serviceIcons: Record<string, string> = {
  'ai-consulting': 'compass',
  'custom-ai-development': 'copilot',
  'ai-voice-agents': 'quote',
  'llm-ai-integration': 'layers',
  'ai-prototype-to-production': 'power',
  'ai-implementation-training': 'people',
  'ai-cost-optimization': 'coins',
  'rag-knowledge-systems': 'stack',
  'enterprise-ai-integration': 'database',
  'ai-workflow-automation': 'route',
};

const workflows = [
  { icon: 'doc', t: 'Reading documents', d: 'Pull the fields you need out of invoices, forms, reports and PDFs, and file them where they belong.' },
  { icon: 'quote', t: 'Routine customer enquiries', d: 'Answer the questions your team answers every day, by chat, email or phone, and pass on the rest.' },
  { icon: 'inbox', t: 'Incoming email and requests', d: 'Read, sort and route what arrives in shared inboxes, with a draft reply ready for review.' },
  { icon: 'target', t: 'Quotes and operational documents', d: 'Prepare quotations and job paperwork from requests, drawings and your own pricing rules.' },
  { icon: 'shield', t: 'Contract review', d: 'Find the clauses that matter, rate the risk and point to the exact passage for a reviewer.' },
  { icon: 'database', t: 'Updating business records', d: 'Keep the CRM, ERP and helpdesk up to date from the conversations and documents that change them.' },
  { icon: 'layers', t: 'AI inside your own apps', d: 'Add a copilot, smart search or summaries to the software your team or your customers already use.' },
  { icon: 'stack', t: 'Answers from company knowledge', d: 'Let staff ask questions of your policies, manuals and past work, and get answers with the source attached.' },
];

const flow = [
  { who: 'AI', t: 'Processes the work', d: 'Reads the request or document, gathers what it needs from your systems and prepares the result.' },
  { who: 'Person', t: 'Validates', d: 'Checks the draft and the evidence behind it, and edits anything that is not right.' },
  { who: 'Person', t: 'Approves', d: 'Sensitive actions, such as sending, paying or changing a record, wait for a yes.' },
  { who: 'AI', t: 'Escalates', d: 'Anything outside its limits goes straight to the right person, with the context attached.', branch: true },
  { who: 'AI', t: 'Completes the action', d: 'Updates the record, sends the message or files the document, and logs what it did.' },
];

const strengths = [
  { t: 'Business first', d: 'We start from how your work runs and what it costs today, then decide whether AI is the right answer.' },
  { t: 'Built for you', d: 'Agents are designed around your processes and rules, not adapted from a generic product.' },
  { t: 'Works with your systems', d: 'We build on the email, documents, CRM, ERP and helpdesk you already run. No rip and replace.' },
  { t: 'People stay accountable', d: 'Every agent has approval steps, limits and a log, so a person owns every decision that matters.' },
  { t: 'Practical implementation', d: 'Rollout, training and runbooks are part of the work, so your team can operate what we build.' },
  { t: 'Cost-conscious', d: 'We pick models and tools for the job and help you cut AI spend you do not need.' },
  { t: 'Experience in real operations', d: 'Moksh Group has supported manufacturing and fabrication businesses for 15 years, and works across IT services, construction and professional services.' },
];

const faqs = [
  { q: 'What does Moksh AI do?', a: 'Moksh AI is an AI implementation, integration and automation services company. We help businesses find where AI creates real value, then build it into the systems they already run: AI features in existing apps, RAG assistants that answer from company knowledge, integrations with ERP, CRM and helpdesk systems, automated workflows and document processing, custom AI agents and voice assistants. A person approves anything that matters.' },
  { q: 'Will AI agents replace our staff?', a: 'No. Agents take the repetitive layer of the work. Your people stay responsible for judgement calls, sensitive actions, complex cases and customer relationships. What changes is how your team spends its day.' },
  { q: 'Which business systems can AI agents work with?', a: 'Agents are built on the APIs of the systems you already run, such as email, Microsoft 365 or Google Workspace, your CRM, accounting software, helpdesk, PSA or ERP. We do not ask you to replace your stack. On the first call we review your tools and tell you plainly whether an agent can work with them.' },
  { q: 'Are AI agents secure?', a: 'They can be, when they are configured properly. We scope each agent to the minimum access it needs, log every action it takes, keep client data separated, and route sensitive actions to a person for approval. Our security page lists the questions we answer before any build.' },
  { q: 'How does human approval work?', a: 'For each agent we agree which actions it may take on its own, which need a person’s approval, and which it must never take. Anything that needs approval arrives with the agent’s draft and the information it used, so the reviewer can approve, edit or reject it in one step. Every action is logged, and approvals can be loosened later only where the results support it.' },
  { q: 'How does the implementation process work?', a: 'In three steps, each ending in a decision you make. Discovery maps one workflow and agrees how success will be measured. A pilot runs one agent on that workflow with approval switched on. Scale extends what works to neighbouring workflows, with training and runbooks for your team.' },
  { q: 'How do we get started?', a: 'Book a 30-minute strategy call and tell us about one workflow that takes up your team’s time. We tell you whether an agent fits, which systems it would touch and what a discovery would involve. Every engagement is quoted as a fixed scope before work starts.' },
  { q: 'What is the difference between RAG, automation and AI agents?', a: 'RAG (retrieval-augmented generation) lets AI answer from your own documents and data, with sources. Workflow automation runs a defined process end to end, with AI handling steps such as reading a document or classifying a request. An agent decides its own steps towards a goal and takes actions in your systems. Most projects combine them, and we recommend the simplest one that does the job.' },
  { q: 'Which industries can benefit from AI automation?', a: `Any business with repeatable, rules-based work. We already have agents, guides or demos for managed service providers and their clients, manufacturing and operations, fintech and insurance, healthcare, real estate, legal and professional services, and e-commerce. We work with teams worldwide, and support is available ${site.supportHours}.` },
];
---
<Base
  title="AI Implementation, Integration & Automation Services | Moksh AI"
  description="Moksh AI builds AI into the systems you already run: AI features in existing apps, RAG knowledge assistants, ERP and CRM integrations, workflow and document automation and custom AI agents, with people in control."
  schema={[faq(faqs), videoObject(introVideo)]}
>
  <!-- 1. HERO: the only section with ambient lighting -->
  <section class="hero wash glow" aria-labelledby="hero-h">
    <div class="container hero-grid">
      <div class="hero-copy">
        <span class="eyebrow">AI implementation, integration and automation</span>
        <h1 id="hero-h"><span class="h1-kicker">AI + Human:</span> Built into your business, <span class="grad-text">with your people in control</span></h1>
        <p class="lede">We put AI to work inside the systems you already run: AI features in your apps, assistants that answer from your own knowledge, integrations with your ERP and CRM, automated workflows and custom agents. A person approves every decision that matters.</p>
        <div class="btn-row">
          <a class="btn btn-primary" href="/book/">Book a strategy call <Arrow /></a>
          <a class="btn btn-secondary" href="/services/">See what we build</a>
        </div>
        <ul class="proof" role="list">
          <li>Built around your existing workflows</li>
          <li>Human approval where it matters</li>
          <li>Designed for real business operations</li>
        </ul>
      </div>
      <div class="hero-visual"><HeroRender /></div>
    </div>
    <div class="hero-runway" data-hero-runway aria-hidden="true"></div>
  </section>

  <!-- 2. WORK AI CAN HANDLE: editorial list -->
  <section class="section" aria-labelledby="work-h">
    <div class="container">
      <div class="head">
        <span class="eyebrow">What we automate</span>
        <h2 id="work-h">Where AI is paying off for businesses today</h2>
        <p class="lede">Most of the value comes from AI connected to your own data and systems, not from another standalone tool. These are the jobs we are asked to take on first, each with a person in the loop for anything unusual or sensitive.</p>
      </div>
      <ol class="work" role="list">
        {workflows.map((w, i) => (
          <li>
            <span class="hexi sm soft"><Icon name={w.icon} /></span>
            <div>
              <h3><span class="mono w-n">{String(i + 1).padStart(2, '0')}</span>{w.t}</h3>
              <p>{w.d}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- 3. DEMO AGENTS -->
  <section class="section sky" aria-labelledby="demo-h">
    <div class="container">
      <div class="row-head">
        <div class="stack-sm">
          <span class="eyebrow">Demo agents</span>
          <h2 id="demo-h">See what intelligent automation looks like in practice</h2>
          <p class="note">Working demonstrations we run live on a call with sample data. The previews are illustrations, not customer deployments.</p>
        </div>
        <a class="link-arrow" href="/agents/">All {agents.length} demo agents</a>
      </div>
      <div class="agent-grid">{homeAgents.map((a) => <AgentCard agent={a} />)}</div>
    </div>
  </section>

  <!-- 4. INDUSTRIES: manufacturing featured, the rest as a list -->
  <section class="section" aria-labelledby="ind-h">
    <div class="container">
      <div class="row-head">
        <div class="stack-sm">
          <span class="eyebrow">Industries</span>
          <h2 id="ind-h">AI automation designed for the way your industry works</h2>
        </div>
        <a class="link-arrow" href="/industries/">All industries</a>
      </div>
      <div class="ind">
        <a class="ind-feature dark" href={manufacturing.href}>
          <span class="tag">Where Moksh Group started</span>
          <span class="if-title">{manufacturing.name}</span>
          <span class="if-text">Moksh Group has supported manufacturing and fabrication businesses for 15 years. Agents prepare quotes from RFQs and drawings, read incoming documents, answer order-status questions and take the handoffs out of the back office.</span>
          <span class="if-tasks mono">Quoting · Intake · Order status · Back office</span>
          <span class="link-arrow">AI for manufacturing and operations</span>
        </a>
        <ul class="ind-list" role="list">
          {otherIndustries.map((i) => (
            <li><a href={i.href}><span class="hexi sm"><Icon name={i.icon} /></span><span class="ind-t"><strong>{i.name}</strong><small>{i.note}</small></span></a></li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <!-- 5. SERVICES: numbered editorial list -->
  <section class="section mint" aria-labelledby="svc-h">
    <div class="container">
      <div class="row-head">
        <div class="stack-sm">
          <span class="eyebrow">Services</span>
          <h2 id="svc-h">Everything you need to turn AI opportunities into working business solutions</h2>
        </div>
        <a class="link-arrow" href="/services/">All services</a>
      </div>
      <ol class="svc-list" role="list">
        {services.map((s, i) => (
          <li data-group={s.group}>
            {(i === 0 || services[i - 1].group !== s.group) && <span class="svc-group mono">{s.group === 'Plan' ? 'Plan · decide what is worth doing' : s.group === 'Build' ? 'Build · put AI into your business' : 'Run · adopt it and keep it affordable'}</span>}
            <a href={`/services/${s.slug}/`}>
              <span class="svc-n mono">{String(i + 1).padStart(2, '0')}</span>
              <span class="svc-name"><span class="svc-ic" aria-hidden="true"><Icon name={serviceIcons[s.slug] ?? 'copilot'} /></span>{s.name}</span>
              <span class="svc-text">{s.short}</span>
              <span class="svc-go" aria-hidden="true"><Arrow /></span>
            </a>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- 6. AI + HUMAN: the operating model, with the CEO -->
  <section class="section dark" aria-labelledby="human-h">
    <div class="container">
      <div class="head">
        <span class="eyebrow">AI plus human</span>
        <h2 id="human-h">AI handles the repetitive work while your people keep the decisions that matter</h2>
        <p class="lede">AI processes, analyses and prepares the work. People supervise sensitive actions, review exceptions and make the calls that need judgement. Every step is logged.</p>
      </div>
      <div class="flow-wrap">
      <div class="flow-bar" aria-hidden="true"></div>
      <ol class="flow" role="list">
        {flow.map((f, i) => (
          <li class:list={['flow-step', { person: f.who === 'Person', branch: f.branch }]}>
            <span class="flow-who mono">{String(i + 1).padStart(2, '0')} · {f.who}</span>
            <h3>{f.t}</h3>
            <p>{f.d}</p>
          </li>
        ))}
      </ol>
      </div>
      <p class="small-link">The rule behind every agent we build: read <a href="/human-in-the-loop-ai-approval-design/">how we design approval steps</a>.</p>
      <div class="ceo"><FounderVideo heading="Why Moksh Group started Moksh AI" /></div>
    </div>
  </section>

  <!-- 7. HOW WE WORK -->
  <section class="section" aria-labelledby="how-h">
    <div class="container">
      <div class="head">
        <span class="eyebrow">How we work</span>
        <h2 id="how-h">From the first workflow to measurable business automation</h2>
      </div>
      <ol class="steps" role="list">
        <li class="step">
          <span class="step-n">01</span>
          <h3>Discovery</h3>
          <p>We map one business workflow, understand the systems behind it and find where automation makes sense.</p>
          <dl><dt>Outcome</dt><dd>A prioritised automation opportunity and an agreed measurement baseline</dd></dl>
        </li>
        <li class="step">
          <span class="step-n">02</span>
          <h3>Pilot</h3>
          <p>We build an agent for the chosen workflow with human approval switched on, and run it against live work.</p>
          <dl><dt>Outcome</dt><dd>Measured performance on your own workflow and data</dd></dl>
        </li>
        <li class="step">
          <span class="step-n">03</span>
          <h3>Scale</h3>
          <p>We extend what works into neighbouring workflows, train your team and set up the operating procedures.</p>
          <dl><dt>Outcome</dt><dd>AI your team can operate, supervise and improve</dd></dl>
        </li>
      </ol>
      <div class="after-steps">
        <p>Each step ends in a decision you make, and every engagement is quoted as a fixed scope before work starts.</p>
        <a class="link-arrow" href="/how-we-work/">How we work in detail</a>
      </div>
    </div>
  </section>

  <!-- 8. VALUE: live calculator with stated assumptions -->
  <section class="section sky" aria-labelledby="roi-h" id="estimate">
    <div class="container roi">
      <div class="stack-sm">
        <span class="eyebrow">Free calculators</span>
        <h2 id="roi-h">Understand the value of automation before you invest</h2>
        <p class="lede">Estimate time saved, workload removed and what it is worth, with your own numbers. The formulas are shown and nothing is sent anywhere.</p>
        <ul class="tool-list" role="list">
          {tools.filter((t) => t.slug !== 'msp-ticket-roi').map((t) => (<li><a href={`/tools/${t.slug}/`}><strong>{t.name}</strong><span>{t.description}</span></a></li>))}
        </ul>
        <p class="note">Results are estimates from the inputs you enter, not a promise of savings. A pilot measures the real figure on your own work.</p>
      </div>
      <div class="roi-calc"><MiniCalc /></div>
    </div>
  </section>

  <!-- 9. WHY MOKSH AI -->
  <section class="section" aria-labelledby="why-h">
    <div class="container why">
      <div class="stack-sm why-head">
        <span class="eyebrow">Why Moksh AI</span>
        <h2 id="why-h">Practical AI expertise, built around your business</h2>
        <dl class="why-facts">
          <div><dt>Contracting</dt><dd>US office, Lake Hiawatha, New Jersey</dd></div>
          <div><dt>Delivery</dt><dd>Engineering team in Ahmedabad, India</dd></div>
          <div><dt>Support</dt><dd>Available {site.supportHours}</dd></div>
          <div><dt>Team</dt><dd>{site.teamSize} across Moksh</dd></div>
          <div><dt>Group</dt><dd>Part of <a href="https://moksh-group.com/" rel="noopener">Moksh Group</a></dd></div>
        </dl>
      </div>
      <ol class="why-list" role="list">
        {strengths.map((s, i) => (<li><span class="mono">{String(i + 1).padStart(2, '0')}</span><div><h3>{s.t}</h3><p>{s.d}</p></div></li>))}
      </ol>
    </div>
  </section>

  <!-- 10. FAQ -->
  <section class="section mint" aria-labelledby="faq-h">
    <div class="container faq-grid">
      <div class="stack-sm">
        <h2 id="faq-h">Questions buyers ask first</h2>
        <p class="lede">If yours is not here, ask it on the call.</p>
      </div>
      <Faq items={faqs} />
    </div>
  </section>

  <!-- 11. CLOSING CTA: flat ink into the footer -->
  <CtaBand
    title="Let’s find the right AI opportunity for your business"
    text="Tell us about a workflow that takes up your team’s time. We’ll tell you whether AI automation makes sense and what an implementation could look like."
    primaryLabel="Book a 30-minute strategy call"
    secondaryHref="/services/"
    secondaryLabel="See what we build"
  />
</Base>

<style>
  /* hero */
  .hero { padding-block: clamp(48px, 7vw, 104px) clamp(56px, 7vw, 96px); }
  .hero.glow::before { opacity: .16; }
  .hero.glow::after { opacity: .12; }
  .hero-grid { display: grid; grid-template-columns: minmax(0, .92fr) minmax(0, 1.08fr); gap: clamp(32px, 4vw, 64px); align-items: center; }
  @media (max-width: 980px) { .hero-grid { grid-template-columns: minmax(0, 1fr); } }
  .hero-copy { display: grid; gap: 24px; position: relative; z-index: 1; }
  .hero h1 { max-width: 16ch; font-size: clamp(2.4rem, 1.4rem + 3.4vw, 4.1rem); }
  .h1-kicker { display: block; margin-bottom: .12em; font-size: .62em; letter-spacing: .02em; text-transform: uppercase; }
  .hero .lede { max-width: 48ch; }
  .proof { list-style: none; margin: 4px 0 0; padding: 18px 0 0; border-top: 1px solid var(--line); display: flex; flex-wrap: wrap; gap: 10px 22px; font-size: var(--t-sm); color: var(--muted); }
  .proof li { display: inline-flex; align-items: center; gap: 8px; }
  .proof li::before { content: ""; width: 10px; height: 5px; border-left: 2px solid var(--green-700); border-bottom: 2px solid var(--green-700); transform: rotate(-45deg) translateY(-2px); }
  .hero-visual { position: relative; }
  /* Desktop: hold the hero while the visitor scrolls the runway, so the stack's
     fold into the AI layer happens on screen (HeroRender reads the runway). */
  .hero-runway { display: none; }
  @media (min-width: 981px) and (min-height: 820px) and (prefers-reduced-motion: no-preference) {
    .hero-grid { position: sticky; top: calc(76px + clamp(48px, 7vw, 104px)); }
    .hero-runway { display: block; height: 60vh; }
  }

  .note { font-size: var(--t-sm); color: var(--muted); max-width: 64ch; }
  .row-head { display: flex; justify-content: space-between; align-items: end; gap: 16px 32px; flex-wrap: wrap; margin-bottom: clamp(28px, 4vw, 44px); }
  .row-head h2 { max-width: 24ch; }

  /* 2. work */
  .work { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); column-gap: clamp(28px, 5vw, 72px); }
  @media (max-width: 760px) { .work { grid-template-columns: minmax(0, 1fr); } }
  .work li { display: grid; grid-template-columns: auto minmax(0, 1fr); gap: 18px; align-items: start; padding-block: 22px; border-top: 1px solid var(--line); }
  .work h3 { font-size: var(--t-lg); display: flex; align-items: baseline; gap: 10px; }
  .w-n { font-size: var(--t-xs); color: var(--muted); font-weight: 500; }
  .work p { margin-top: 6px; color: var(--muted); }

  /* 3. agents */
  .agent-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 330px), 1fr)); gap: 24px; }

  /* 4. industries */
  .ind { display: grid; grid-template-columns: minmax(0, .9fr) minmax(0, 1.1fr); gap: clamp(24px, 4vw, 56px); align-items: stretch; }
  @media (max-width: 900px) { .ind { grid-template-columns: minmax(0, 1fr); } }
  .ind-feature { display: grid; gap: 16px; align-content: start; padding: clamp(26px, 3.4vw, 44px); border-radius: 18px; text-decoration: none; color: var(--ink); position: relative; overflow: hidden; isolation: isolate; transition: transform .25s var(--ease); }
  .ind-feature::after { content: ""; position: absolute; z-index: -1; right: -80px; bottom: -80px; width: 260px; height: 260px; border-radius: 50%; background: radial-gradient(circle, rgba(31, 169, 47, .28), transparent 70%); pointer-events: none; }
  .ind-feature:hover { transform: translateY(-3px); color: var(--ink); }
  .if-title { font: 750 var(--t-2xl)/1.05 var(--f-display); font-stretch: 86%; letter-spacing: -0.02em; }
  .if-text { color: var(--muted); max-width: 52ch; }
  .if-tasks { font-size: var(--t-xs); letter-spacing: .06em; text-transform: uppercase; color: var(--teal-700); }
  .ind-list { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); column-gap: 28px; align-content: start; }
  @media (max-width: 560px) { .ind-list { grid-template-columns: minmax(0, 1fr); } }
  .ind-list a { display: flex; align-items: center; gap: 14px; min-height: 76px; padding-block: 14px; border-bottom: 1px solid var(--line); color: inherit; text-decoration: none; }
  .ind-t { display: grid; gap: 2px; }
  .ind-t strong { font-weight: 600; transition: color .2s var(--ease); }
  .ind-t small { font-size: var(--t-xs); color: var(--muted); }
  .ind-list a:hover strong { color: var(--blue-700); }

  /* 5. services */
  .svc-list { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--line-strong); }
  .svc-list a { display: grid; grid-template-columns: 56px minmax(0, .95fr) minmax(0, 1.25fr) 40px; gap: 24px; align-items: center; padding-block: 24px; border-bottom: 1px solid var(--line-strong); color: inherit; text-decoration: none; transition: background-color .25s var(--ease), padding .25s var(--ease); }
  .svc-list a:hover { background: var(--surface); padding-inline: 16px; }
  .svc-n { font-size: var(--t-sm); color: var(--muted); }
  .svc-group { display: block; padding: 28px 0 10px; font-size: var(--t-xs); letter-spacing: .1em; text-transform: uppercase; color: var(--teal-700); }
  .svc-name { display: flex; align-items: center; gap: 14px; font: 700 var(--t-lg)/1.2 var(--f-display); font-stretch: 90%; letter-spacing: -0.01em; }
  .svc-ic { display: grid; place-items: center; width: 36px; height: 36px; flex: none; border-radius: 10px; background: var(--surface); border: 1px solid var(--line); color: var(--teal-700); }
  .svc-ic :global(svg) { width: 18px; height: 18px; }
  .svc-text { color: var(--muted); }
  .svc-go { justify-self: end; color: var(--blue-700); }
  .svc-go :global(svg) { width: 20px; height: 20px; transition: transform .25s var(--ease); }
  .svc-list a:hover .svc-go :global(svg) { transform: translateX(4px); }
  @media (max-width: 860px) { .svc-list a { grid-template-columns: 36px minmax(0, 1fr); gap: 8px 14px; } .svc-text { grid-column: 2; } .svc-go { display: none; } }

  /* 6. AI + human */
  .flow { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); gap: 14px; position: relative; }
  @media (max-width: 1000px) { .flow { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 560px) { .flow { grid-template-columns: minmax(0, 1fr); } }
  .flow-step { display: grid; gap: 8px; align-content: start; padding: 20px; border-radius: var(--radius); border: 1px solid var(--line); background: var(--surface); position: relative; }
  .flow-step h3 { font-size: var(--t-lg); }
  .flow-step p { font-size: var(--t-sm); color: var(--muted); }
  .flow-who { font-size: var(--t-xs); letter-spacing: .06em; text-transform: uppercase; color: var(--teal-700); }
  .flow-step.person { border-color: rgba(242, 180, 92, .45); }
  .flow-step.person .flow-who { color: var(--amber); }
  .flow-step.branch { border-style: dashed; }
  .small-link { margin-top: 22px; font-size: var(--t-sm); color: var(--muted); }
  .ceo { margin-top: clamp(44px, 6vw, 72px); padding-top: clamp(36px, 5vw, 56px); border-top: 1px solid var(--line); }

  .after-steps { margin-top: 32px; display: flex; flex-wrap: wrap; justify-content: space-between; align-items: baseline; gap: 12px 32px; }
  .after-steps p { color: var(--muted); max-width: 64ch; }

  /* 8. value */
  .roi { display: grid; grid-template-columns: minmax(0, .9fr) minmax(0, 1.1fr); gap: clamp(28px, 5vw, 64px); align-items: start; }
  @media (max-width: 960px) { .roi { grid-template-columns: minmax(0, 1fr); } }
  .tool-list { list-style: none; margin: 8px 0 0; padding: 0; }
  .tool-list a { display: grid; gap: 4px; padding-block: 14px; border-bottom: 1px solid var(--line-strong); color: inherit; text-decoration: none; }
  .tool-list a strong { color: var(--ink); transition: color .2s var(--ease); }
  .tool-list a span { font-size: var(--t-sm); color: var(--muted); }
  .tool-list a:hover strong { color: var(--blue-700); }

  /* 9. why */
  .why { display: grid; grid-template-columns: minmax(0, .8fr) minmax(0, 1.2fr); gap: clamp(32px, 5vw, 80px); align-items: start; }
  @media (max-width: 900px) { .why { grid-template-columns: minmax(0, 1fr); } }
  .why-facts { margin: 12px 0 0; display: grid; gap: 0; border-top: 1px solid var(--line); }
  .why-facts div { display: grid; grid-template-columns: 110px minmax(0, 1fr); gap: 12px; padding-block: 12px; border-bottom: 1px solid var(--line); font-size: var(--t-sm); }
  .why-facts dt { font: 500 var(--t-xs)/1.6 var(--f-mono); letter-spacing: .07em; text-transform: uppercase; color: var(--muted); }
  .why-facts dd { margin: 0; }
  .why-list { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0 32px; }
  @media (max-width: 600px) { .why-list { grid-template-columns: minmax(0, 1fr); } }
  .why-list li { display: grid; grid-template-columns: 34px minmax(0, 1fr); gap: 10px; padding-block: 20px; border-top: 1px solid var(--line); }
  .why-list .mono { font-size: var(--t-xs); color: var(--teal-700); padding-top: 4px; }
  .why-list h3 { font-size: var(--t-lg); }
  .why-list p { margin-top: 6px; color: var(--muted); font-size: var(--t-sm); }

  .faq-grid { display: grid; grid-template-columns: minmax(0, .75fr) minmax(0, 1.25fr); gap: clamp(32px, 5vw, 72px); align-items: start; }
  @media (max-width: 900px) { .faq-grid { grid-template-columns: minmax(0, 1fr); } }

  /* ---------------------------------------------------------------------------
     Scroll motion. Each section moves differently; content is readable at rest
     (transforms only, never opacity), nothing moves layout, browsers without
     scroll timelines and reduced-motion visitors get the static page.
     The FAQ and the closing CTA are deliberately still.
     ------------------------------------------------------------------------- */
  section { overflow-x: clip; }
  .flow-wrap { position: relative; }
  .flow-bar { position: absolute; left: 0; right: 0; top: -18px; height: 2px; border-radius: 2px; background: var(--grad); transform-origin: left; }
  @media (min-width: 901px) { .why-head { position: sticky; top: 112px; } }

  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {

      /* 2. work: the two columns slide in from opposite sides */
      .work li { animation: sc-slide linear both; animation-timeline: view(); animation-range: entry 0% entry 80%; --from-x: -40px; }
      .work li:nth-child(even) { --from-x: 40px; }
      @media (max-width: 760px) { .work li, .work li:nth-child(even) { --from-x: 0px; } }

      /* 3. demo agents: dealt like a hand of cards, then settle flat */
      .agent-grid > :global(*) { animation: sc-deal linear both; animation-timeline: view(); animation-range: entry 0% cover 38%; transform-origin: 50% 100%; }
      .agent-grid > :global(*:nth-child(1)) { --rot: -6deg; --dx: 60px; }
      .agent-grid > :global(*:nth-child(2)) { --rot: 0deg; --dx: 0px; }
      .agent-grid > :global(*:nth-child(3)) { --rot: 6deg; --dx: -60px; }
      @media (max-width: 760px) { .agent-grid > :global(*) { --rot: 0deg !important; --dx: 0px !important; } }

      /* 4. industries: the manufacturing panel grows in, its light drifts across */
      .ind-feature { animation: sc-grow linear both; animation-timeline: view(); animation-range: entry 0% entry 90%; }
      .ind-feature::after { animation: sc-drift linear both; animation-timeline: view(); animation-range: cover 0% cover 100%; }
      .ind-list li { animation: sc-rise linear both; animation-timeline: view(); animation-range: entry 0% entry 100%; }

      /* 5. services: each rule draws across, numbers and arrows slide home */
      .svc-list li { position: relative; }
      .svc-list li::before { content: ""; position: absolute; left: 0; right: 0; top: -1px; height: 2px; background: var(--teal); transform-origin: left; animation: sc-draw linear both; animation-timeline: view(); animation-range: entry 20% cover 45%; }
      .svc-n, .svc-go { animation: sc-nudge linear both; animation-timeline: view(); animation-range: entry 10% cover 40%; }

      /* 6. AI + human (the peak): the bar runs along the flow and each step
         rises as it arrives */
      .flow-wrap { view-timeline: --flow block; }
      .flow-bar { animation: sc-draw linear both; animation-timeline: --flow; animation-range: entry 60% cover 62%; }
      .flow-step { animation: sc-step linear both; animation-timeline: --flow; }
      .flow-step:nth-child(1) { animation-range: entry 50% cover 30%; }
      .flow-step:nth-child(2) { animation-range: entry 70% cover 38%; }
      .flow-step:nth-child(3) { animation-range: entry 90% cover 46%; }
      .flow-step:nth-child(4) { animation-range: cover 22% cover 54%; }
      .flow-step:nth-child(5) { animation-range: cover 30% cover 62%; }

      /* 7. how we work: the connector draws, the hexagon numbers turn into place */
      .steps { view-timeline: --steps block; }
      .steps::before { transform-origin: left; animation: sc-draw linear both; animation-timeline: --steps; animation-range: entry 40% cover 50%; }
      .step-n { animation: sc-turn linear both; animation-timeline: view(); animation-range: entry 20% cover 35%; }

      /* 8. value: the calculator tilts up off the page */
      .roi-calc { animation: sc-tilt linear both; animation-timeline: view(); animation-range: entry 0% cover 40%; transform-origin: 50% 100%; }

      /* 9. why: the heading holds (sticky) while the list scrolls past. No animation. */
    }
  }
  @keyframes sc-slide { from { transform: translate(var(--from-x), 36px); } }
  @keyframes sc-deal { from { transform: translate(var(--dx), 90px) rotate(var(--rot)) scale(.94); } }
  @keyframes sc-grow { from { transform: scale(.9) translateY(30px); } }
  @keyframes sc-drift { from { transform: translate(-260px, -200px); } to { transform: translate(40px, 30px); } }
  @keyframes sc-rise { from { transform: translateY(32px); } }
  @keyframes sc-draw { from { transform: scaleX(0); } }
  @keyframes sc-nudge { from { transform: translateX(-28px); } }
  @keyframes sc-step { from { transform: translateY(56px) scale(.94); } }
  @keyframes sc-turn { from { transform: rotate(-120deg) scale(.5); } }
  @keyframes sc-tilt { from { transform: perspective(1100px) rotateX(18deg) translateY(60px); } }
</style>
