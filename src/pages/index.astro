  }
</style>

<script>
  // Scroll choreography for the homepage. Runs only on wide, tall screens with
  // motion allowed; everywhere else the page is a normal document and the
  // approval demo advances as it crosses the middle of the screen.
  const root = document.documentElement;
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const wide = matchMedia('(min-width: 981px) and (min-height: 700px)');
  const clamp = (v: number, a = 0, b = 1) => Math.min(b, Math.max(a, v));
  const $ = <T extends Element = HTMLElement>(s: string) => document.querySelector<T & HTMLElement>(s)!;
  const $$ = (s: string, r: ParentNode = document) => Array.from(r.querySelectorAll<HTMLElement>(s));

  const tall = matchMedia('(min-height: 540px)');
  const setMotion = () => {
    root.classList.toggle('motion', !reduce && wide.matches);
    root.classList.toggle('path-pinned', !reduce && tall.matches);
  };
  setMotion();
  wide.addEventListener('change', () => { setMotion(); tick(); });
  tall.addEventListener('change', () => { setMotion(); tick(); });

  const progress = (el: HTMLElement) => { const r = el.getBoundingClientRect(); return clamp(-r.top / Math.max(1, r.height - innerHeight)); };
  // Fallback progress when not pinned: how far the element has crossed the screen.
  const crossing = (el: HTMLElement) => { const r = el.getBoundingClientRect(); return clamp((innerHeight * 0.85 - r.top) / (innerHeight * 0.6)); };

  /* approval demo */
  const steps = $$('[data-steps] li');
  const stepsEl = $('[data-steps]');
  const flowSteps = $$('[data-flow] li');
  const status = $('[data-status]');
  const btn = $<HTMLButtonElement>('[data-approve]');
  const stamp = $('[data-stamp]');
  const STATUS: [string, string][] = [
    ['Waiting to start.', 'Scroll to run the agent.'],
    ['Reading the request.', 'Pulling the email and its attachments.'],
    ['Extracting line items.', '14 found on the purchase request.'],
    ['Drafting the quote.', 'Matching the price list and supplier terms.'],
    ['Held for your approval.', 'One discount is above policy. Nothing has been sent.'],
  ];
  let approved = false;
  const say = (s: [string, string]) => { status.innerHTML = `${s[0]}<small>${s[1]}</small>`; };
  const renderGate = (p: number) => {
    if (approved) return;
    const a = clamp(p / 0.5);
    const stage = a <= 0.02 ? 0 : a < 0.25 ? 1 : a < 0.5 ? 2 : a < 0.75 ? 3 : 4;
    stepsEl.style.setProperty('--ap', String(Math.min(a, 0.75)));
    steps.forEach((li, i) => { li.classList.toggle('on', i < Math.min(stage, 3)); li.classList.toggle('hold', i === 3 && stage === 4); });
    flowSteps.forEach((li, i) => li.classList.toggle('lit', (i === 0 && stage >= 1) || (i === 1 && stage === 4)));
    say(STATUS[stage]);
    btn.disabled = stage < 4;
    stamp.textContent = stage === 4 ? 'On hold' : 'Draft';
  };
  btn.addEventListener('click', () => {
    if (btn.disabled || approved) return;
    approved = true;
    stepsEl.style.setProperty('--ap', '1');
    steps.forEach((li) => { li.classList.remove('hold'); li.classList.add('on', 'done'); });
    flowSteps.forEach((li) => li.classList.toggle('lit', !li.classList.contains('branch')));
    say(['Approved and sent.', 'A person signed off, and every step is in the log.']);
    stamp.textContent = 'Sent';
    btn.textContent = 'Approved';
    btn.disabled = true;
  });

  if (reduce) {
    $$('[data-chores] li').forEach((li) => li.classList.add('done'));
    renderGate(1);
  }

  /* hero planes follow scroll and, on desktop, the pointer */
  const hero = $('[data-act="hero"]');
  const planes = $$('[data-depth]', hero);
  const copy = $('[data-copy]');
  let tx = 0, ty = 0, px = 0, py = 0;
  const fine = matchMedia('(pointer: fine)').matches;
  if (fine) addEventListener('pointermove', (e) => { tx = e.clientX / innerWidth - 0.5; ty = e.clientY / innerHeight - 0.5; request(); }, { passive: true });

  const chores = $('[data-act="work"]');
  const choreItems = $$('[data-chores] li');
  const captionList = $('[data-layers]');
  const layerItems = $$('[data-layers] li');
  document.addEventListener('layer-change', (e) => {
    const i = (e as CustomEvent<number>).detail;
    captionList.classList.add('live');
    layerItems.forEach((li, k) => li.classList.toggle('on', k === i));
  });
  const hush = $('[data-hush]');
  const gate = $('[data-act="gate"]');
  const run = $('[data-run]');
  const range = $('[data-act="range"]');
  const wipe = $('[data-wipe]');
  const phases = $$('[data-phases] .phase');

  let queued = false;
  function request() { if (!queued) { queued = true; requestAnimationFrame(tick); } }
  function tick() {
    queued = false;
    const motion = root.classList.contains('motion');
    px += (tx - px) * 0.08; py += (ty - py) * 0.08;

    if (motion) {
      const hp = progress(hero);
      planes.forEach((pl) => {
        const d = Number(pl.dataset.depth);
        pl.style.transform = `translate3d(${px * d * 1.2}px, ${-hp * d * 5 + py * d * 0.6}px, 0)`;
      });
      copy.style.transform = `translate3d(0, ${-hp * 60}px, 0)`;

      const cp = progress(chores);
      choreItems.forEach((li, i) => li.classList.toggle('done', cp > (i + 0.6) / (choreItems.length + 1.2)));

      if (!reduce) renderGate(progress(gate));

      const rp = progress(range);
      wipe.style.setProperty('--w', `${clamp((rp - 0.3) / 0.4) * 100}%`);

      phases.forEach((ph, i) => {
        const next = phases[i + 1];
        if (!next) return;
        const t = clamp(1 - (next.getBoundingClientRect().top - 140) / (innerHeight * 0.6));
        ph.style.transform = `scale(${1 - t * 0.05})`;
      });
    } else {
      planes.forEach((pl) => (pl.style.transform = ''));
      copy.style.transform = '';
      phases.forEach((ph) => (ph.style.transform = ''));
      if (!reduce) {
        choreItems.forEach((li) => li.classList.toggle('done', li.getBoundingClientRect().top < innerHeight * 0.6));
        renderGate(crossing(run));
      }
    }

    const r = hush.getBoundingClientRect();
    const mid = 1 - Math.abs(r.top + r.height / 2 - innerHeight / 2) / (innerHeight * 0.55);
    hush.style.setProperty('--o', String(reduce ? 1 : clamp(mid, 0.18, 1)));

    if (Math.abs(tx - px) > 0.001 || Math.abs(ty - py) > 0.001) request();
  }
  addEventListener('scroll', request, { passive: true });
  addEventListener('resize', request);
  tick();
</script>
