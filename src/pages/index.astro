---
import Base from '../layouts/Base.astro';
import Arrow from '../components/Arrow.astro';
import Icon from '../components/Icon.astro';
import HexField from '../components/HexField.astro';
import Hub from '../components/scenes/Hub.astro';
import SplitTable from '../components/SplitTable.astro';
import MiniCalc from '../components/MiniCalc.astro';
import Faq from '../components/Faq.astro';
import CtaBand from '../components/CtaBand.astro';
import { services } from '../site.config';
import { faq } from '../lib/schema';
import { tools } from '../lib/tools';
import { allPosts, featuredPost, audienceLabel, readingMinutes } from '../lib/insights';
import { topicBySlug } from '../lib/topics';

const posts = await allPosts();
const featured = featuredPost(posts);
const morePosts = posts.filter((p) => p.id !== featured?.id).slice(0, 4);
const otherTools = tools.filter((t) => t.slug !== 'msp-ticket-roi');
// Systems named here must be ones Moksh AI can build on today. Confirm before launch.
const systems = ['ConnectWise', 'Autotask', 'HaloPSA', 'NinjaOne', 'Microsoft 365', 'Your ERP'];

const faqs = [
  { q: 'What does Moksh AI do?', a: 'We design, build and run AI agents and automation for managed service providers and operations-heavy businesses. The agents work inside the tools you already use, take on repetitive work such as ticket triage, alert filtering and document preparation, and hand anything outside their limits to a person with the context attached.' },
  { q: 'Will AI agents replace our technicians?', a: 'No. Agents take the repetitive layer of the work. Engineers stay responsible for diagnosis, security-sensitive actions, complex cases and client relationships. What changes is how your team spends its day.' },
  { q: 'Which tools do your agents work with?', a: 'Agents are built on the APIs of the systems you already run, typically your PSA or ITSM, RMM, Microsoft 365 and line-of-business software. We do not ask you to replace your stack. On the first call we review your tools and tell you plainly whether an agent can work with them.' },
  { q: 'Are AI agents secure?', a: 'They can be, when they are configured properly. We scope each agent to the minimum access it needs, log every action it takes, keep client data separated, and route security-sensitive actions to an engineer for approval. See our security page for the questions we answer before any build.' },
  { q: 'How does an engagement start?', a: 'With a short discovery on one workflow. We map how the work runs today, agree the baseline and the metric a pilot will be judged on, and give you a ranked list of what is worth automating. You decide whether to pilot.' },
  { q: 'Where is the Moksh AI team?', a: 'Moksh AI is the AI practice of Moksh Infotech Pvt Ltd. We contract from our US office in Lake Hiawatha, New Jersey, and our delivery team works from Ahmedabad, India.' },
];
---
<Base
  title="AI Agents for MSPs & Operations Teams | Moksh AI"
  description="Moksh AI builds AI agents that triage tickets, filter alerts and prepare routine work inside your PSA, RMM and Microsoft 365, while your engineers keep every decision."
  schema={[faq(faqs)]}
>
  <!-- HERO: the only section with ambient lighting -->
  <section class="hero dark glow">
    <div class="container hero-grid">
      <div class="hero-copy">
        <span class="eyebrow">AI agents for MSPs and operations teams</span>
        <h1>AI agents that take the routine work <span class="grad-text">out of your queue</span></h1>
        <p class="lede">Moksh AI builds agents that work inside your PSA, RMM, Microsoft 365 and business systems. They triage, prepare and close repetitive tickets, alerts and requests within limits you set, and hand everything else to an engineer with the context attached.</p>
        <div class="btn-row">
          <a class="btn btn-primary" href="/book/">Book a strategy call <Arrow /></a>
          <a class="btn btn-secondary" href="#estimate">Estimate your ticket savings</a>
        </div>
        <div class="hero-systems">
          <p class="hs-label">Built on the APIs you already run</p>
          <ul role="list">{systems.map((x) => <li>{x}</li>)}</ul>
        </div>
      </div>
      <div class="hero-visual">
        <HexField class="hero-hex" />
        <Hub
          core={{ title: 'Moksh agent', sub: 'your rules, your stack' }}
          left={[
            { label: 'Email', sub: 'requests in', icon: 'inbox' },
            { label: 'PSA / ITSM', sub: 'tickets', icon: 'ticket' },
            { label: 'RMM', sub: 'alerts', icon: 'alert' },
            { label: 'Microsoft 365', sub: 'users', icon: 'people' },
          ]}
          right={[
            { label: 'ERP', sub: 'jobs, orders', icon: 'database' },
            { label: 'Docs & KB', sub: 'past fixes', icon: 'doc' },
            { label: 'Teams / Slack', sub: 'updates', icon: 'quote' },
            { label: 'Engineer', sub: 'approves', icon: 'shield', human: true },
          ]}
          compact={{
            left: [{ label: 'PSA', icon: 'ticket' }, { label: 'RMM', icon: 'alert' }],
            right: [{ label: 'Docs', icon: 'doc' }, { label: 'Engineer', icon: 'shield', human: true }],
          }}
          steps={['Observe', 'Decide', 'Act', 'Hand off']}
          caption="Illustrative: one agent connected to the systems you already run."
        />
      </div>
    </div>
  </section>

  <!-- WHO IT'S FOR: two plain routes, no cards -->
  <section class="section">
    <div class="container">
      <h2 class="paths-h reveal">Built for MSPs and operations-heavy teams</h2>
      <div class="paths">
        <a class="path reveal" href="/msp/">
          <span class="path-top"><span class="hexi"><Icon name="ticket" /></span><span class="tag">Managed service providers</span></span>
          <span class="path-h">Take tier-1 tickets and alert noise off your technicians</span>
          <span class="path-p">Triage, routine resolutions, alert correlation and documentation, inside your PSA and RMM.</span>
          <span class="link-arrow">AI for MSPs</span>
        </a>
        <a class="path reveal" href="/operations/">
          <span class="path-top"><span class="hexi"><Icon name="inbox" /></span><span class="tag">Operations-heavy businesses</span></span>
          <span class="path-h">Get hours back from quoting, intake and back-office handoffs</span>
          <span class="path-p">Quotes from RFQs and drawings, document intake, order status and reporting across your systems.</span>
          <span class="link-arrow">AI for operations</span>
        </a>
      </div>
    </div>
  </section>

  <!-- STATEMENT + OPERATING MODEL -->
  <section class="section wash">
    <div class="container model">
      <div class="model-copy reveal">
        <h2 class="statement">Every real decision belongs to a person</h2>
        <p class="muted">The agent takes the repetitive layer. Anything that needs judgement, carries security risk or touches a client relationship goes to an engineer, with the context already attached.</p>
        <p class="small-link">The rule behind every agent we build. Read <a href="/human-in-the-loop-ai-approval-design/">how we design approval steps</a>.</p>
      </div>
      <div class="reveal"><SplitTable /></div>
    </div>
  </section>

  <!-- SERVICES: editorial list, not cards -->
  <section class="section">
    <div class="container">
      <div class="row-head reveal">
        <h2>Strategy, build, rollout and cost control</h2>
        <a class="link-arrow" href="/services/">All services</a>
      </div>
      <ol class="svc-list" role="list">
        {services.map((s, i) => (
          <li class="reveal">
            <a href={`/services/${s.slug}/`}>
              <span class="svc-n mono">0{i + 1}</span>
              <span class="svc-name">{s.name}</span>
              <span class="svc-text">{s.short}</span>
              <span class="svc-go" aria-hidden="true"><Arrow /></span>
            </a>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- PROCESS -->
  <section class="section sky">
    <div class="container">
      <div class="head reveal">
        <span class="eyebrow">How an engagement runs</span>
        <h2>Three steps, each ending in a decision you make</h2>
      </div>
      <ol class="steps" role="list">
        <li class="step reveal">
          <span class="step-n">01</span>
          <h3>Discovery</h3>
          <p>We map one workflow end to end: who touches it, which systems hold the data, and where the time goes. We agree the baseline and the metric a pilot will be judged on.</p>
          <dl><dt>You get</dt><dd>A ranked list of what is worth automating, and what is not</dd><dt>You decide</dt><dd>Whether to pilot, and which workflow</dd></dl>
        </li>
        <li class="step reveal">
          <span class="step-n">02</span>
          <h3>Pilot</h3>
          <p>We build one agent on one queue, with human approval switched on. It runs against live work and is measured against the baseline from discovery.</p>
          <dl><dt>You get</dt><dd>Measured results on your own data</dd><dt>You decide</dt><dd>Keep it, change it, or stop</dd></dl>
        </li>
        <li class="step reveal">
          <span class="step-n">03</span>
          <h3>Scale</h3>
          <p>We extend to neighbouring workflows, loosen approvals where the data supports it, train your team and hand over runbooks. Accuracy and running cost are reviewed every month.</p>
          <dl><dt>You get</dt><dd>Agents your team owns and trusts</dd><dt>You decide</dt><dd>What comes next, on evidence</dd></dl>
        </li>
      </ol>
      <div class="after-steps">
        <p>You contract with our New Jersey office; the build team works from Ahmedabad. Running cost and accuracy are reviewed with you every month.</p>
        <a class="link-arrow" href="/how-we-work/">How we work in detail</a>
      </div>
    </div>
  </section>

  <!-- LIVE CALCULATOR -->
  <section class="section dark" id="estimate">
    <div class="container calc-sec">
      <div class="calc-copy reveal">
        <span class="eyebrow">Free calculators</span>
        <h2>Estimate your ticket savings</h2>
        <p class="lede">Move the sliders. Nothing is sent anywhere and no email is needed.</p>
        <p class="more-label">More calculators</p>
        <ul class="more-tools" role="list">
          {otherTools.map((t) => (<li><a href={`/tools/${t.slug}/`}>{t.name}</a></li>))}
        </ul>
      </div>
      <div class="reveal"><MiniCalc /></div>
    </div>
  </section>

  <!-- INSIGHTS: one featured row -->
  <section class="section">
    <div class="container">
      <div class="row-head reveal">
        <h2>Notes from the work</h2>
        <a class="link-arrow" href="/insights/">All insights</a>
      </div>
      {featured && (
        <a class="feature reveal" href={`/${featured.id}/`}>
          <span class="feature-main">
            <span class="tag">{audienceLabel(featured.data.audience)} · {readingMinutes(featured.body)} min read</span>
            <span class="feature-title">{featured.data.title}</span>
            <span class="feature-text">{featured.data.summary}</span>
            <span class="link-arrow">Read the guide</span>
          </span>
          {featured.data.takeaways.length > 0 && (
            <span class="feature-side">
              <span class="tag">In this guide</span>
              <span class="feature-points">{featured.data.takeaways.slice(0, 3).map((t) => <span>{t}</span>)}</span>
            </span>
          )}
        </a>
      )}
      <ul class="post-links" role="list">
        {morePosts.map((p) => (<li><a href={`/${p.id}/`}>{p.data.title}</a><span class="tag">{topicBySlug(p.data.topic).name}</span></li>))}
      </ul>
    </div>
  </section>

  <!-- FAQ -->
  <section class="section sky">
    <div class="container faq-grid">
      <div class="stack-sm reveal">
        <h2>Questions buyers ask first</h2>
        <p class="lede">If yours is not here, ask it on the call.</p>
      </div>
      <Faq items={faqs} />
    </div>
  </section>

  <CtaBand />
</Base>

<style>
  .hero { padding-block: clamp(64px, 9vw, 128px) clamp(64px, 8vw, 112px); }
  .hero::before { opacity: .7; }
  .hero::after { opacity: .5; }
  .hero-grid { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.1fr); gap: clamp(36px, 5vw, 80px); align-items: center; }
  @media (max-width: 980px) { .hero-grid { grid-template-columns: minmax(0, 1fr); } }
  .hero-copy { display: grid; gap: 26px; position: relative; z-index: 1; }
  .hero h1 { color: #fff; max-width: 15ch; }
  .hero-visual { position: relative; isolation: isolate; }
  .hero-visual :global(.hero-hex) { width: 130%; left: -15%; top: -12%; opacity: .55; }
  .hero-systems { margin-top: 8px; padding-top: 22px; border-top: 1px solid rgba(255, 255, 255, .12); display: grid; gap: 12px; }
  .hs-label { font: 500 var(--t-xs)/1.2 var(--f-mono); letter-spacing: .08em; text-transform: uppercase; color: var(--on-dark-muted); }
  .hero-systems ul { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 8px; }
  .hero-systems li { font-size: var(--t-sm); font-weight: 500; color: var(--on-dark); padding: 6px 12px; border: 1px solid rgba(255, 255, 255, .16); border-radius: 999px; background: rgba(255, 255, 255, .04); }

  .paths-h { max-width: 20ch; margin-bottom: clamp(28px, 4vw, 44px); }
  .paths { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: clamp(28px, 5vw, 72px); }
  @media (max-width: 760px) { .paths { grid-template-columns: minmax(0, 1fr); } }
  .path { display: grid; gap: 14px; align-content: start; padding-top: 24px; border-top: 3px solid; border-image: var(--grad) 1; color: inherit; text-decoration: none; }
  .path-top { display: flex; align-items: center; gap: 14px; }
  .path-h { font: 700 var(--t-xl)/1.15 var(--f-display); font-stretch: 88%; letter-spacing: -0.01em; max-width: 24ch; transition: color .2s var(--ease); }
  .path:hover .path-h { color: var(--blue-700); }
  .path-p { color: var(--muted); max-width: 52ch; }

  .model { display: grid; grid-template-columns: minmax(0, .8fr) minmax(0, 1.2fr); gap: clamp(28px, 5vw, 72px); align-items: center; }
  @media (max-width: 980px) { .model { grid-template-columns: minmax(0, 1fr); } }
  .model-copy { display: grid; gap: 16px; }
  .statement { max-width: 16ch; }
  .muted { color: var(--muted); }
  .small-link { font-size: var(--t-sm); color: var(--muted); }

  .row-head { display: flex; justify-content: space-between; align-items: end; gap: 16px; flex-wrap: wrap; margin-bottom: clamp(28px, 4vw, 44px); }
  .svc-list { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--ink); }
  .svc-list a { display: grid; grid-template-columns: 72px minmax(0, .9fr) minmax(0, 1.3fr) 40px; gap: 24px; align-items: baseline; padding-block: 28px; border-bottom: 1px solid var(--line-strong); color: inherit; text-decoration: none; transition: background-color .25s var(--ease), padding .25s var(--ease); }
  .svc-list a:hover { background: var(--surface); padding-inline: 16px; }
  .svc-n { font-size: var(--t-sm); color: var(--muted); }
  .svc-name { font: 700 var(--t-xl)/1.15 var(--f-display); font-stretch: 88%; letter-spacing: -0.01em; }
  .svc-text { color: var(--muted); }
  .svc-go { justify-self: end; color: var(--blue-700); }
  .svc-go :global(svg) { width: 20px; height: 20px; transition: transform .25s var(--ease); }
  .svc-list a:hover .svc-go :global(svg) { transform: translateX(4px); }
  @media (max-width: 860px) { .svc-list a { grid-template-columns: 44px minmax(0, 1fr); gap: 6px 14px; } .svc-text { grid-column: 2; } .svc-go { display: none; } }

  .after-steps { margin-top: 32px; display: flex; flex-wrap: wrap; justify-content: space-between; align-items: baseline; gap: 12px 32px; }
  .after-steps p { color: var(--muted); max-width: 64ch; }

  .calc-sec { display: grid; grid-template-columns: minmax(0, .7fr) minmax(0, 1.3fr); gap: clamp(32px, 5vw, 72px); align-items: center; }
  @media (max-width: 980px) { .calc-sec { grid-template-columns: minmax(0, 1fr); } }
  .calc-copy { display: grid; gap: 18px; align-content: start; }
  .more-label { margin-top: 12px; font: 500 var(--t-xs)/1.2 var(--f-mono); letter-spacing: .1em; text-transform: uppercase; color: var(--on-dark-muted); }
  .more-tools { list-style: none; margin: 0; padding: 0; border-top: 1px solid rgba(255, 255, 255, .12); }
  .more-tools li { border-bottom: 1px solid rgba(255, 255, 255, .12); }
  .more-tools a { display: flex; justify-content: space-between; padding-block: 12px; color: var(--on-dark) !important; text-decoration: none; font-weight: 500; }
  .more-tools a::after { content: "→"; color: var(--teal-on-dark); transition: transform .2s var(--ease); }
  .more-tools a:hover::after { transform: translateX(4px); }

  .feature { display: grid; grid-template-columns: minmax(0, 1.5fr) minmax(0, 1fr); gap: clamp(24px, 4vw, 56px); align-items: start; padding: clamp(24px, 4vw, 48px); background: var(--surface); border: 1px solid var(--line); border-radius: var(--radius); text-decoration: none; color: inherit; transition: box-shadow .25s var(--ease), transform .25s var(--ease); }
  .feature:hover { box-shadow: var(--shadow-2); transform: translateY(-2px); color: inherit; }
  @media (max-width: 860px) { .feature { grid-template-columns: minmax(0, 1fr); } }
  .feature-main { display: grid; gap: 12px; }
  .feature-side { display: grid; gap: 14px; padding-left: clamp(0px, 3vw, 32px); border-left: 1px solid var(--line); }
  @media (max-width: 860px) { .feature-side { padding-left: 0; border-left: 0; padding-top: 18px; border-top: 1px solid var(--line); } }
  .feature-points { display: grid; gap: 12px; }
  .feature-points span { padding-left: 16px; border-left: 2px solid var(--teal); color: var(--ink); line-height: 1.5; }
  .feature-title { font: 750 var(--t-2xl)/1.08 var(--f-display); font-stretch: 86%; letter-spacing: -0.02em; max-width: 24ch; }
  .feature-text { color: var(--muted); max-width: 68ch; font-size: var(--t-lg); }
  .post-links { list-style: none; margin: 28px 0 0; padding: 0; border-top: 1px solid var(--line); }
  .post-links li { display: flex; justify-content: space-between; align-items: baseline; gap: 16px; padding-block: 16px; border-bottom: 1px solid var(--line); }
  .post-links a { font-weight: 600; text-decoration: none; }

  .faq-grid { display: grid; grid-template-columns: minmax(0, .75fr) minmax(0, 1.25fr); gap: clamp(32px, 5vw, 72px); align-items: start; }
  @media (max-width: 900px) { .faq-grid { grid-template-columns: minmax(0, 1fr); } }
</style>
