---
import Base from '../layouts/Base.astro';
import Arrow from '../components/Arrow.astro';
import Icon from '../components/Icon.astro';
import HexField from '../components/HexField.astro';
import Hero3D from '../components/scenes/Hero3D.astro';
import Faq from '../components/Faq.astro';
import CtaBand from '../components/CtaBand.astro';
import FounderVideo from '../components/FounderVideo.astro';
import { introVideo } from '../lib/introVideo';
import { services, site } from '../site.config';
import AgentCard from '../components/agents/AgentCard.astro';
import { agents } from '../lib/agents';
import { industries } from '../lib/industries';
import { faq, videoObject } from '../lib/schema';

// One agent each from healthcare, finance and legal on the homepage; the rest live on /agents/.
const homeAgents = ['medical-report-insights', 'financial-reasoning', 'legal-document-review'].map((slug) => agents.find((a) => a.slug === slug)!);

const faqs = [
  { q: 'What does Moksh AI do?', a: 'We design, build and run AI agents and automation for businesses of any size and industry, anywhere in the world. The agents work inside the tools you already use, take on repetitive work such as answering routine requests, reading documents, updating records and preparing reports, and hand anything outside their limits to a person with the context attached.' },
  { q: 'Will AI agents replace our staff?', a: 'No. Agents take the repetitive layer of the work. Your people stay responsible for judgement calls, sensitive actions, complex cases and customer relationships. What changes is how your team spends its day.' },
  { q: 'Which tools do your agents work with?', a: 'Agents are built on the APIs of the systems you already run, such as email, Microsoft 365 or Google Workspace, your CRM, accounting software, helpdesk or ERP. We do not ask you to replace your stack. On the first call we review your tools and tell you plainly whether an agent can work with them.' },
  { q: 'Are AI agents secure?', a: 'They can be, when they are configured properly. We scope each agent to the minimum access it needs, log every action it takes, keep client data separated, and route sensitive actions to a person for approval. See our security page for the questions we answer before any build.' },
  { q: 'Where is the Moksh AI team, and who do you work with?', a: `We work with clients worldwide. Moksh AI is the AI practice of Moksh Infotech Pvt Ltd: we contract from our US office in Lake Hiawatha, New Jersey, our delivery team works from Ahmedabad, India, and support is available ${site.supportHours}.` },
];
---
<Base
  title="AI Agents & Automation for Any Business | Moksh AI"
  description={`Moksh AI builds AI agents and automation for businesses worldwide, inside the tools you already use, with a person checking the work. Support available ${site.supportHours}.`}
  schema={[faq(faqs), videoObject(introVideo)]}
>
  <!-- HERO: the only section with ambient lighting -->
  <section class="hero dark glow">
    <div class="container hero-grid">
      <div class="hero-copy">
        <h1>AI agents for any business, <span class="grad-text">checked by a human</span></h1>
        <p class="lede">Agents that read, check and draft inside the tools you already use. A person approves every decision that matters.</p>
        <div class="btn-row">
          <a class="btn btn-primary" href="/book/">Book a strategy call <Arrow /></a>
          <a class="btn btn-secondary" href="/agents/">See the demo agents</a>
        </div>
        <ul class="hero-meta mono" role="list" aria-label="Industries we support">{['Healthcare', 'Finance', 'Legal', 'Real estate', 'E-commerce', 'MSPs', 'Operations', '24/7 support'].map((x) => <li>{x}</li>)}</ul>
      </div>
      <div class="hero-visual">
        <HexField class="hero-hex" />
        <Hero3D />
      </div>
    </div>
  </section>

  <!-- DEMO AGENTS: three of the agents we show on calls -->
  <section class="section" aria-labelledby="demo-h">
    <div class="container">
      <div class="row-head">
        <div class="stack-sm">
          <span class="eyebrow">Demo agents</span>
          <h2 id="demo-h">Agents we can show you working today</h2>
        </div>
        <a class="link-arrow" href="/agents/">All {agents.length} demo agents</a>
      </div>
      <div class="agent-grid">{homeAgents.map((a) => <AgentCard agent={a} />)}</div>
    </div>
  </section>

  <!-- WE SUPPORT: every industry with a page behind it -->
  <section class="section sky" aria-labelledby="ind-h">
    <div class="container">
      <div class="row-head">
        <div class="stack-sm">
          <span class="eyebrow">We support</span>
          <h2 id="ind-h">Built for teams in these industries, and any business with repeatable work</h2>
        </div>
        <a class="link-arrow" href="/industries/">All industries</a>
      </div>
      <ul class="ind-list" role="list">
        {industries.map((i) => (
          <li><a href={i.href}><span class="hexi sm"><Icon name={i.icon} /></span><span class="ind-t"><strong>{i.name}</strong><small>{i.note}</small></span></a></li>
        ))}
      </ul>
    </div>
  </section>

  <!-- SERVICES: editorial list, not cards -->
  <section class="section">
    <div class="container">
      <div class="row-head reveal">
        <h2>What we build, and how we help you run it</h2>
        <a class="link-arrow" href="/services/">All services</a>
      </div>
      <ol class="svc-list" role="list">
        {services.map((s, i) => (
          <li class="reveal">
            <a href={`/services/${s.slug}/`}>
              <span class="svc-n mono">0{i + 1}</span>
              <span class="svc-name">{s.name}</span>
              <span class="svc-text">{s.short}</span>
              <span class="svc-go" aria-hidden="true"><Arrow /></span>
            </a>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- CEO VIDEO: the first real person on the site -->
  <section class="section mint">
    <div class="container"><FounderVideo /></div>
  </section>

  <!-- PROCESS -->
  <section class="section sky">
    <div class="container">
      <div class="head reveal">
        <span class="eyebrow">How an engagement runs</span>
        <h2>Three steps, each ending in a decision you make</h2>
      </div>
      <ol class="steps" role="list">
        <li class="step reveal">
          <span class="step-n">01</span>
          <h3>Discovery</h3>
          <p>We map one workflow end to end: who touches it, which systems hold the data, and where the time goes. We agree the baseline and the metric a pilot will be judged on.</p>
          <dl><dt>You get</dt><dd>A ranked list of what is worth automating, and what is not</dd><dt>You decide</dt><dd>Whether to pilot, and which workflow</dd></dl>
        </li>
        <li class="step reveal">
          <span class="step-n">02</span>
          <h3>Pilot</h3>
          <p>We build one agent on one queue, with human approval switched on. It runs against live work and is measured against the baseline from discovery.</p>
          <dl><dt>You get</dt><dd>Measured results on your own data</dd><dt>You decide</dt><dd>Keep it, change it, or stop</dd></dl>
        </li>
        <li class="step reveal">
          <span class="step-n">03</span>
          <h3>Scale</h3>
          <p>We extend to neighbouring workflows, loosen approvals where the data supports it, train your team and hand over runbooks. Accuracy and running cost are reviewed every month.</p>
          <dl><dt>You get</dt><dd>Agents your team owns and trusts</dd><dt>You decide</dt><dd>What comes next, on evidence</dd></dl>
        </li>
      </ol>
      <div class="after-steps">
        <p>You contract with our New Jersey office; the build team works from Ahmedabad. Running cost and accuracy are reviewed with you every month.</p>
        <a class="link-arrow" href="/how-we-work/">How we work in detail</a>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="section">
    <div class="container faq-grid">
      <div class="stack-sm reveal">
        <h2>Questions buyers ask first</h2>
        <p class="lede">If yours is not here, ask it on the call.</p>
      </div>
      <Faq items={faqs} />
    </div>
  </section>

  <CtaBand />
</Base>

<style>
  .hero { padding-block: clamp(64px, 9vw, 128px) clamp(64px, 8vw, 112px); }
  .hero::before { opacity: .7; }
  .hero::after { opacity: .5; }
  .hero-grid { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.1fr); gap: clamp(36px, 5vw, 80px); align-items: center; }
  @media (max-width: 980px) { .hero-grid { grid-template-columns: minmax(0, 1fr); } }
  .hero-copy { display: grid; gap: 26px; position: relative; z-index: 1; }
  .hero h1 { color: #fff; max-width: 15ch; font-size: clamp(2.4rem, 1.5rem + 3vw, 3.9rem); }
  .hero .lede { max-width: 44ch; }
  .hero-meta { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 8px 18px; max-width: 56ch; font-size: var(--t-xs); letter-spacing: .06em; text-transform: uppercase; color: var(--on-dark-muted); }
  .hero-meta li { white-space: nowrap; }
  .hero-meta li:last-child { color: var(--green-on-dark); }
  .hero-visual { position: relative; isolation: isolate; }
  .hero-visual :global(.hero-hex) { width: 130%; left: -15%; top: -12%; opacity: .3; }

  .agent-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 340px), 1fr)); gap: 24px; }
  .ind-list { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 0 28px; }
  @media (max-width: 1080px) { .ind-list { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 560px) { .ind-list { grid-template-columns: minmax(0, 1fr); } }
  .ind-list a { display: flex; align-items: center; gap: 14px; min-height: 76px; padding-block: 14px; border-bottom: 1px solid var(--line-strong); color: inherit; text-decoration: none; }
  .ind-t { display: grid; gap: 2px; }
  .ind-t strong { font-weight: 600; transition: color .2s var(--ease); }
  .ind-t small { font-size: var(--t-xs); color: var(--muted); }
  .ind-list a:hover strong { color: var(--blue-700); }


  .row-head { display: flex; justify-content: space-between; align-items: end; gap: 16px; flex-wrap: wrap; margin-bottom: clamp(28px, 4vw, 44px); }
  .svc-list { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--line-strong); }
  .svc-list a { display: grid; grid-template-columns: 72px minmax(0, .9fr) minmax(0, 1.3fr) 40px; gap: 24px; align-items: baseline; padding-block: 28px; border-bottom: 1px solid var(--line-strong); color: inherit; text-decoration: none; transition: background-color .25s var(--ease), padding .25s var(--ease); }
  .svc-list a:hover { background: var(--surface); padding-inline: 16px; }
  .svc-n { font-size: var(--t-sm); color: var(--muted); }
  .svc-name { font: 700 var(--t-xl)/1.15 var(--f-display); font-stretch: 88%; letter-spacing: -0.01em; }
  .svc-text { color: var(--muted); }
  .svc-go { justify-self: end; color: var(--blue-700); }
  .svc-go :global(svg) { width: 20px; height: 20px; transition: transform .25s var(--ease); }
  .svc-list a:hover .svc-go :global(svg) { transform: translateX(4px); }
  @media (max-width: 860px) { .svc-list a { grid-template-columns: 44px minmax(0, 1fr); gap: 6px 14px; } .svc-text { grid-column: 2; } .svc-go { display: none; } }

  .after-steps { margin-top: 32px; display: flex; flex-wrap: wrap; justify-content: space-between; align-items: baseline; gap: 12px 32px; }
  .after-steps p { color: var(--muted); max-width: 64ch; }



  .faq-grid { display: grid; grid-template-columns: minmax(0, .75fr) minmax(0, 1.25fr); gap: clamp(32px, 5vw, 72px); align-items: start; }
  @media (max-width: 900px) { .faq-grid { grid-template-columns: minmax(0, 1fr); } }
</style>
