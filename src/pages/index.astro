  .chores h3 { display: flex; justify-content: space-between; gap: 16px; align-items: baseline; font-size: clamp(1.1rem, .9rem + .7vw, 1.45rem); }
  .chores p { color: var(--muted); font-size: var(--t-sm); line-height: 1.5; margin-top: 3px; max-width: 60ch; }
  .strike { position: relative; transition: color .5s var(--ease); }
  .strike::after { content: ""; position: absolute; left: -2px; right: -2px; top: 55%; height: 2px; background: var(--green); transform: scaleX(0); transform-origin: left; transition: transform .6s var(--ease); }
  .handled { font-size: var(--t-xs); color: var(--green-on-dark); white-space: nowrap; transform: translateX(-8px); opacity: 0; transition: transform .5s var(--ease), opacity .5s; }
  .chores li.done .strike { color: var(--muted); }
  .chores li.done .strike::after { transform: scaleX(1); }
  .chores li.done .handled { opacity: 1; transform: none; }

  /* 3 path: five cards. Pinned (html.path-pinned) they stand in a 3D row and scroll turns them;
     otherwise they are a swipeable row. Each card is a real link with its own text. */
  .path-pin { display: grid; align-content: center; gap: clamp(18px, 3vh, 36px); padding-block: clamp(56px, 7vw, 96px); }
