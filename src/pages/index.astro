<script>
  // Homepage choreography with GSAP + ScrollTrigger, kept in step with the
  // site-wide Lenis smooth scroll (src/lib/smooth-scroll.ts).
  // - Pinned acts use CSS sticky (.act/.pin) so the page works without JS;
  //   GSAP only scrubs what happens inside them.
  // - html.motion (wide, tall screens) pins the hero and the approval demo;
  //   html.path-pinned (any screen 540 px+) pins the five-layers deck.
  // - Reduced motion: no smooth scroll, no reveals, everything in its final state.
  // - Reveals move and unmask content (transform / clip-path); they never fade it.
  import { startSmoothScroll } from '../lib/smooth-scroll';

  // GSAP loads after the first frame has painted, so the hero text is on screen
  // before any motion code is fetched or run (mobile LCP).
  await new Promise<void>((r) => requestAnimationFrame(() => setTimeout(r, 0)));
  const [{ default: gsap }, { ScrollTrigger }, { SplitText }] = await Promise.all([
    import('gsap'), import('gsap/ScrollTrigger'), import('gsap/SplitText'),
  ]);

  gsap.registerPlugin(ScrollTrigger, SplitText);

  const root = document.documentElement;
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const clamp = (v: number, a = 0, b = 1) => Math.min(b, Math.max(a, v));
  const $ = <T extends Element = HTMLElement>(s: string, r: ParentNode = document) => r.querySelector<T & HTMLElement>(s)!;
  const $$ = (s: string, r: ParentNode = document) => Array.from(r.querySelectorAll<HTMLElement>(s));

  const lenis = startSmoothScroll();
  if (lenis) {
    lenis.on('scroll', ScrollTrigger.update);
  }
  const scrollToY = (y: number) => (lenis ? lenis.scrollTo(y, { duration: 1.1 }) : scrollTo({ top: y, behavior: reduce ? 'auto' : 'smooth' }));

  const wideQ = '(min-width: 981px) and (min-height: 700px) and (prefers-reduced-motion: no-preference)';
  const tallQ = '(min-height: 540px) and (prefers-reduced-motion: no-preference)';
  const setMotion = () => {
    root.classList.toggle('motion', matchMedia(wideQ).matches);
    root.classList.toggle('path-pinned', matchMedia(tallQ).matches);
  };
  setMotion();

  /* ---------------- approval demo (shared by every layout) ---------------- */
  const steps = $$('[data-steps] li');
  const stepsEl = $('[data-steps]');
  const flowSteps = $$('[data-flow] li');
  const status = $('[data-status]');
  const btn = $<HTMLButtonElement>('[data-approve]');
  const stamp = $('[data-stamp]');
  const STATUS: [string, string][] = [
    ['Waiting to start.', 'Scroll to run the agent.'],
    ['Reading the request.', 'Pulling the email and its attachments.'],
    ['Extracting line items.', '14 found on the purchase request.'],
    ['Drafting the quote.', 'Matching the price list and supplier terms.'],
    ['Held for your approval.', 'One discount is above policy. Nothing has been sent.'],
  ];
  let approved = false;
  let lastStage = -1;
  const say = (s: [string, string]) => {
    status.innerHTML = `${s[0]}<small>${s[1]}</small>`;
    if (!reduce) gsap.fromTo(status, { y: 10, clipPath: 'inset(0 0 100% 0)' }, { y: 0, clipPath: 'inset(0 0 0% 0)', duration: 0.45, ease: 'power3.out' });
  };
  const renderGate = (p: number) => {
    if (approved) return;
    const a = clamp(p / 0.62);
    const stage = a <= 0.02 ? 0 : a < 0.25 ? 1 : a < 0.5 ? 2 : a < 0.75 ? 3 : 4;
    stepsEl.style.setProperty('--ap', String(Math.min(a, 0.75)));
    if (stage === lastStage) return;
    lastStage = stage;
    steps.forEach((li, i) => { li.classList.toggle('on', i < Math.min(stage, 3)); li.classList.toggle('hold', i === 3 && stage === 4); });
    flowSteps.forEach((li, i) => li.classList.toggle('lit', (i === 0 && stage >= 1) || (i === 1 && stage === 4)));
    say(STATUS[stage]);
    btn.disabled = stage < 4;
    stamp.textContent = stage === 4 ? 'On hold' : 'Draft';
    if (stage === 4 && !reduce) gsap.fromTo(btn, { scale: 0.92 }, { scale: 1, duration: 0.6, ease: 'elastic.out(1, 0.45)' });
  };
  btn.addEventListener('click', () => {
    if (btn.disabled || approved) return;
    approved = true;
    stepsEl.style.setProperty('--ap', '1');
    steps.forEach((li) => { li.classList.remove('hold'); li.classList.add('on', 'done'); });
    flowSteps.forEach((li) => li.classList.toggle('lit', !li.classList.contains('branch')));
    say(['Approved and sent.', 'A person signed off, and every step is in the log.']);
    stamp.textContent = 'Sent';
    btn.textContent = 'Approved';
    btn.disabled = true;
    if (!reduce) {
      gsap.fromTo(stamp, { scale: 1.8, rotation: -14 }, { scale: 1, rotation: -4, duration: 0.55, ease: 'back.out(2.2)' });
      gsap.fromTo(flowSteps.filter((li) => !li.classList.contains('branch')), { x: -14 }, { x: 0, duration: 0.5, stagger: 0.07, ease: 'power3.out' });
    }
  });

  /* ---------------- five-layers deck ---------------- */
  const path = $('[data-act="path"]');
  const cards = $$('[data-deck] .lcard');
  const COUNT = cards.length;
  const LAST_AT = 0.64; // share of the runway by which the last card is in front; it holds to the end
  const STEP = LAST_AT / (COUNT - 1);
  let deckP = 0;
  const pathPinned = () => root.classList.contains('path-pinned');
  const scrollToCard = (i: number) => {
    const top = path.getBoundingClientRect().top + scrollY;
    const span = path.offsetHeight - innerHeight;
    scrollToY(top + span * (i === COUNT - 1 ? LAST_AT + 0.06 : i * STEP));
  };
  cards.forEach((card, i) => {
    const link = card.querySelector('a')!;
    // a side card comes to the front first; the front card's link works as normal
    link.addEventListener('click', (e) => { if (pathPinned() && Math.round(deckP) !== i) { e.preventDefault(); scrollToCard(i); } });
    link.addEventListener('focus', () => { if (pathPinned() && Math.round(deckP) !== i) scrollToCard(i); });
  });
  const placeDeck = (P: number) => {
    deckP = P;
    const cw = cards[0].offsetWidth;
    cards.forEach((c, k) => {
      const d = k - P, a = Math.abs(d);
      gsap.set(c, {
        x: Math.sign(d) * Math.min(a, 2.4) * cw * 0.72,
        z: -a * 220,
        rotationY: clamp(-d * 36, -64, 64),
        scale: 1 - Math.min(a, 2) * 0.05,
        filter: `brightness(${1 - Math.min(a, 2) * 0.32})`,
        zIndex: 100 - Math.round(a * 10),
        visibility: a > 2.2 ? 'hidden' : 'inherit',
      });
      c.classList.toggle('front', a < 0.5);
    });
  };

  /* ---------------- reduced motion: final states, nothing moves ---------------- */
  if (reduce) {
    $$('[data-chores] li').forEach((li) => li.classList.add('done'));
    renderGate(1);
  } else {
    const mm = gsap.matchMedia();

    /* headings rise out of a mask, line by line (every section heading except the hero's) */
    const splitHeadings = $$('main h2').filter((h) => !h.closest('.hero'));
    splitHeadings.forEach((h) => {
      SplitText.create(h, {
        type: 'lines', mask: 'lines', linesClass: 'ln', autoSplit: true,
        onSplit: (self) => gsap.from(self.lines, {
          yPercent: 105, duration: 1, stagger: 0.09, ease: 'expo.out',
          scrollTrigger: { trigger: h, start: 'top 88%', once: true },
        }),
      });
    });

    /* hero: the headline assembles on load, then the planes part as you scroll */
    const hero = $('[data-act="hero"]');
    const copy = $('[data-copy]');
    const docs = $$('.docs .doc', hero);
    const fore = $('.fore-card', hero);
    // the hero's entrance is CSS keyframes (see '1 hero' styles): it runs from the very
    // first frame, so the headline never paints, vanishes and re-enters while GSAP loads

    mm.add(wideQ, () => {
      // scroll: depth planes drift apart, the stack fans out, the copy lifts away
      const tl = gsap.timeline({ scrollTrigger: { trigger: hero, start: 'top top', end: 'bottom bottom', scrub: 0.8 } });
      $$('[data-depth]', hero).forEach((pl) => tl.to(pl, { y: -Number(pl.dataset.depth) * 9, ease: 'none' }, 0));
      tl.to(docs[0], { rotation: -16, x: -60, ease: 'none' }, 0)
        .to(docs[1], { rotation: -7, x: -20, ease: 'none' }, 0)
        .to(docs[2], { rotation: 8, x: 30, ease: 'none' }, 0)
        .to(copy, { y: -110, scale: 0.97, transformOrigin: '0% 0%', ease: 'none' }, 0)
        .to(fore, { y: -120, rotation: -3, ease: 'none' }, 0)
        // hand-off: the page's own navy rises over the planes as the hero leaves
        .fromTo($('.p-atmo', hero), { height: '26%' }, { height: '85%', ease: 'power1.in' }, 0.35);
      // pointer: the planes lean toward the cursor
      const leans = $$('[data-depth]', hero).map((pl) => ({ d: Number(pl.dataset.depth), x: gsap.quickTo(pl, 'x', { duration: 0.9, ease: 'power3.out' }) }));
      const onMove = (e: PointerEvent) => { const nx = e.clientX / innerWidth - 0.5; leans.forEach((l) => l.x(nx * l.d * 1.6)); };
      if (matchMedia('(pointer: fine)').matches) addEventListener('pointermove', onMove, { passive: true });

      // approval demo runs on scroll through its pinned stage
      ScrollTrigger.create({ trigger: $('[data-act="gate"]'), start: 'top top', end: 'bottom bottom', onUpdate: (st) => renderGate(st.progress) });

      return () => removeEventListener('pointermove', onMove);
    });
    mm.add('(max-width: 980px), (max-height: 699px)', () => {
      // unpinned: the demo advances as it crosses the screen
      ScrollTrigger.create({ trigger: $('[data-run]'), start: 'top 85%', end: 'top 25%', onUpdate: (st) => renderGate(st.progress) });
    });

    mm.add(tallQ, () => {
      // deck: scroll turns the cards, then settles on the nearest one
      placeDeck(0);
      ScrollTrigger.create({
        trigger: path, start: 'top top', end: 'bottom bottom', scrub: 0.6,
        snap: { snapTo: (v) => (v >= LAST_AT ? v : Math.round(v / STEP) * STEP), duration: { min: 0.25, max: 0.7 }, delay: 0.08, ease: 'power3.inOut' },
        onUpdate: (st) => placeDeck(clamp(st.progress / LAST_AT) * (COUNT - 1)),
      });
      gsap.from(cards, { y: 120, rotationX: -20, duration: 1.3, stagger: 0.08, ease: 'expo.out', scrollTrigger: { trigger: path, start: 'top 70%', once: true } });
      return () => cards.forEach((c) => { gsap.set(c, { clearProps: 'all' }); c.classList.remove('front'); });
    });

    /* workflows strike through, one after another, as they cross the screen */
    ScrollTrigger.batch($$('[data-chores] li'), {
      start: 'top 70%', once: true,
      onEnter: (els) => els.forEach((li, i) => gsap.delayedCall(i * 0.12, () => li.classList.add('done'))),
    });

    /* still sections: each moves differently */
    gsap.from('.agent-grid > *', { y: 90, rotation: 2.5, duration: 1.2, stagger: 0.12, ease: 'expo.out', scrollTrigger: { trigger: '.agent-grid', start: 'top 82%', once: true } });   // deal
    $$('.panels > .panel').forEach((pnl) => gsap.from(pnl, { y: 80, duration: 1.2, ease: 'expo.out', scrollTrigger: { trigger: pnl, start: 'top 85%', once: true } }));     // rise
    gsap.from('.why-list li', { x: -40, duration: 1, stagger: 0.08, ease: 'expo.out', scrollTrigger: { trigger: '.why-list', start: 'top 80%', once: true } });          // draw
    const phases = $$('[data-phases] .phase');
    phases.slice(0, -1).forEach((ph, i) => gsap.to(ph, {                                                                                                           // stack
      scale: 0.94, filter: 'brightness(0.72)', ease: 'none',
      scrollTrigger: { trigger: phases[i + 1], start: 'top 85%', end: 'top 140px', scrub: true },
    }));
    const hush = $('[data-hush]');
    gsap.fromTo(hush, { scale: 0.86, letterSpacing: '-0.04em' }, { scale: 1.06, letterSpacing: '0em', ease: 'none', scrollTrigger: { trigger: hush, start: 'top bottom', end: 'bottom top', scrub: 0.6 } }); // grow
    hush.style.setProperty('--o', '1');

    addEventListener('load', () => ScrollTrigger.refresh());
  }
</script>
