  .deck { list-style: none; margin: 0; padding: 4px var(--gutter) 12px; display: flex; gap: 16px; overflow-x: auto; scroll-snap-type: x mandatory; --cw: min(300px, 78vw); }
  .lcard { flex: 0 0 var(--cw); scroll-snap-align: center; }
  :global(html.path-pinned) .deck { position: relative; display: block; overflow: visible; padding: 0; height: clamp(300px, calc(100svh - 360px), 500px); perspective: 1600px; --cw: min(calc((100svh - 360px) * .74), 370px, 74vw); }
  @media (max-height: 700px) { :global(html.path-pinned) .deck { height: clamp(280px, calc(100svh - 280px), 500px); --cw: min(calc((100svh - 280px) * .74), 370px, 74vw); } }
  :global(html.path-pinned) .lcard { position: absolute; top: 0; left: 50%; width: var(--cw); height: 100%; margin-left: calc(var(--cw) / -2); transform-style: preserve-3d; will-change: transform; }

  .lcard { --c: var(--blue); --c2: var(--teal); }
