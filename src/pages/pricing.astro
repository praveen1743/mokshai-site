---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Faq from '../components/Faq.astro';
import CtaBand from '../components/CtaBand.astro';
import Arrow from '../components/Arrow.astro';
import { breadcrumbs, faq } from '../lib/schema';

const models = [
  { name: 'Discovery', basis: 'Fixed fee', for: 'Finding out what is worth automating', includes: ['Workflow mapping and baseline', 'Ranked automation candidates', 'Business case in your numbers', 'Pilot brief with a stop rule'] },
  { name: 'Pilot', basis: 'Fixed scope, fixed price', for: 'Proving one agent on one queue', includes: ['One agent, one workflow', 'Integration with your systems', 'Human approval switched on', 'Weekly results against the baseline'] },
  { name: 'Scale & run', basis: 'Monthly', for: 'Agents in daily use across teams', includes: ['Further workflows and integrations', 'Training and runbooks', 'Monitoring of accuracy and cost', 'Monthly review with you'] },
];
const faqs = [
  { q: 'Why are there no prices on this page?', a: 'Because the honest answer depends on the workflow, the systems involved and the state of your data. Any number we published would be wrong for most buyers. Every engagement is quoted as a fixed scope before work starts, so you know the cost before you commit.' },
  { q: 'How do I know what to budget?', a: 'Use our AI project budget planner. It works backwards from the value you expect and your payback target to give you an investment ceiling. Bring that number to the first call and we will tell you what can be done within it.' },
  { q: 'What drives the running cost?', a: 'Model usage, hosting and monitoring. We design for cost from the start, including open-source models where they are good enough, and we report running cost every month.' },
  { q: 'Can we stop after discovery?', a: 'Yes. The discovery output is yours, and it is written so your own team or another partner can act on it.' },
];
---
<Base title="Pricing: How AI Engagements Are Priced" description="How Moksh AI prices AI automation work: a fixed-fee discovery, a fixed-scope pilot, then monthly scale and run. Every engagement is quoted before work starts." schema={[breadcrumbs([{ name: 'Pricing', path: '/pricing/' }]), faq(faqs)]}>
  <PageHero eyebrow="Pricing" title="Fixed scope before we start. No surprises after." lede="Three ways to work with us, each quoted as a fixed scope once we understand the workflow. Use the budget planner to set your own ceiling first.">
    <div class="btn-row"><a class="btn btn-primary" href="/tools/ai-budget-planner/">Plan your budget <Arrow /></a><a class="btn btn-secondary" href="/book/">Get a scoped quote</a></div>
  </PageHero>

  <section class="section">
    <div class="container">
      <div class="grid g-3">
        {models.map((m, i) => (
          <div class={`card model${i === 1 ? ' featured' : ''}`}>
            <span class="tag">{m.basis}</span>
            <h2 class="h-model">{m.name}</h2>
            <p>{m.for}</p>
            <ul class="checks">{m.includes.map((x) => <li>{x}</li>)}</ul>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section sky">
    <div class="container faqg">
      <div class="stack-sm"><span class="eyebrow">Questions</span><h2>About pricing</h2></div>
      <Faq items={faqs} />
    </div>
  </section>
  <CtaBand title="Tell us the workflow. We will tell you the price." />
</Base>
<style>
  .h-model { font-size: var(--t-2xl); }
  .model .checks { margin-top: 12px; }
  .featured { border-color: var(--ink); box-shadow: 0 0 0 1px var(--ink); }
  .faqg { display: grid; grid-template-columns: minmax(0, .7fr) minmax(0, 1.3fr); gap: clamp(28px, 5vw, 72px); }
  @media (max-width: 900px) { .faqg { grid-template-columns: minmax(0, 1fr); } }
</style>
