---
import { site, services } from '../site.config';
import { topics } from '../lib/topics';
import { publishedCaseStudies } from '../lib/caseStudies';
const year = new Date().getFullYear();
// Shown only once a case study is published (see /case-studies/).
const hasCaseStudies = (await publishedCaseStudies()).length > 0;
---
<footer class="site-footer dark">
  <div class="lights" aria-hidden="true"></div>
  <div class="container">
    <div class="glass">
    <div class="top">
      <div class="intro">
        <img src="/logo-wordmark.svg" alt="Moksh AI" width="151" height="58" class="logo" />
        <p>AI agents and automation for businesses worldwide, built to work inside the systems you already run and checked by a person.</p>
        <p class="mail">Email <a href={`mailto:${site.email}`}>{site.email}</a></p>
      </div>
      <nav aria-label="Footer: company">
        <h2 class="fh">Company</h2>
        <ul>
          <li><a href="/about/">About</a></li>
          <li><a href="/how-we-work/">How we work</a></li>
          <li><a href="/pricing/">Pricing</a></li>
          <li><a href="/security/">Security</a></li>
          {hasCaseStudies && <li><a href="/case-studies/">Case studies</a></li>}
          <li><a href="/tools/">Calculators</a></li>
          <li><a href="/book/">Book a call</a></li>
        </ul>
      </nav>
      <nav aria-label="Footer: services">
        <h2 class="fh">Services</h2>
        <ul>
          {services.map((s) => <li><a href={`/services/${s.slug}/`}>{s.name}</a></li>)}
        </ul>
      </nav>
      <nav aria-label="Footer: guides">
        <h2 class="fh">Guides</h2>
        <ul>
          {topics.map((t) => <li><a href={`/insights/${t.slug}/`}>{t.name}</a></li>)}
          <li><a href="/insights/">All insights</a></li>
        </ul>
      </nav>
      <div class="offices">
        <h2 class="fh">Offices</h2>
        {site.offices.map((o) => (
          <address>
            <strong>{o.label}</strong><br />
            {o.street}<br />
            {o.locality}, {o.region} {o.postalCode}<br />
            <a href={`tel:${o.phone.replace(/[^+\d]/g, '')}`}>{o.phone}</a>
          </address>
        ))}
      </div>
    </div>

    <div class="group">
      <h2 class="fh">Part of Moksh Group</h2>
      <ul>
        {site.group.map((g) => <li><a href={g.url} rel="noopener">{g.name}</a></li>)}
      </ul>
    </div>
    </div>

    <div class="legal">
      <p>© {year} {site.legalName} (Moksh AI). CIN {site.cin}.</p>
      <ul>
        <li><a href="/privacy-policy/">Privacy policy</a></li>
        <li><a href={site.social.linkedin} rel="noopener">LinkedIn</a></li>
        <li><a href={site.social.facebook} rel="noopener">Facebook</a></li>
        <li><a href={site.social.instagram} rel="noopener">Instagram</a></li>
      </ul>
    </div>
  </div>
</footer>

<style>
  .site-footer { position: relative; isolation: isolate; overflow: clip; padding-block: clamp(32px, 4vw, 48px) calc(32px + env(safe-area-inset-bottom, 0px)); font-size: var(--t-sm); background: var(--ink-deep); }

  /* Glass needs something behind it to bend, or it reads as a flat tinted box.
     Static pools of the logo colours sit behind the panel; nothing animates. */
  .lights { position: absolute; inset: 0; z-index: -1; pointer-events: none;
    background:
      radial-gradient(38% 50% at 4% 34%, rgba(37, 131, 219, .30), transparent 70%),
      radial-gradient(32% 46% at 56% 26%, rgba(22, 163, 176, .26), transparent 70%),
      radial-gradient(36% 56% at 96% 66%, rgba(31, 169, 47, .32), transparent 70%);
    /* Fade in from the top edge so the ink CTA above joins without a seam. */
    -webkit-mask-image: linear-gradient(to bottom, transparent 0, #000 22%);
    mask-image: linear-gradient(to bottom, transparent 0, #000 22%); }

  /* One glass surface. Frosted fill, light top edge, faint lower edge and a
     specular rim drawn with a masked gradient border. */
  .glass { position: relative; border-radius: 28px; padding: clamp(22px, 4vw, 48px) clamp(20px, 4vw, 48px) 8px;
    background: linear-gradient(140deg, rgba(255, 255, 255, .11) 0%, rgba(255, 255, 255, .035) 38%, rgba(255, 255, 255, .02) 62%, rgba(255, 255, 255, .06) 100%);
    -webkit-backdrop-filter: blur(22px) saturate(165%);
    backdrop-filter: blur(22px) saturate(165%);
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, .30), inset 0 -1px 0 rgba(255, 255, 255, .06), 0 30px 70px -20px rgba(0, 0, 0, .55); }
  .glass::before { content: ""; position: absolute; inset: 0; border-radius: inherit; padding: 1px; pointer-events: none;
    background: linear-gradient(140deg, rgba(255, 255, 255, .55), rgba(255, 255, 255, .08) 28%, rgba(255, 255, 255, 0) 55%, rgba(255, 255, 255, .22) 100%);
    -webkit-mask: linear-gradient(#000 0 0) content-box, linear-gradient(#000 0 0); -webkit-mask-composite: xor;
    mask: linear-gradient(#000 0 0) content-box, linear-gradient(#000 0 0); mask-composite: exclude; }
  @supports not ((backdrop-filter: blur(1px)) or (-webkit-backdrop-filter: blur(1px))) { .glass { background: rgba(16, 48, 77, .72); } }
  @media (prefers-reduced-transparency: reduce) { .glass { background: var(--ink-2); -webkit-backdrop-filter: none; backdrop-filter: none; } .lights { display: none; } }
  @media (prefers-contrast: more) { .glass::before { background: rgba(255, 255, 255, .6); } }
  @media (max-width: 520px) { .glass { border-radius: 20px; } }

  .top { display: grid; grid-template-columns: minmax(0, 1.4fr) repeat(4, minmax(0, 1fr)); gap: 36px; padding-bottom: 40px; border-bottom: 1px solid rgba(255, 255, 255, .12); }
  @media (max-width: 1100px) { .top { grid-template-columns: repeat(2, minmax(0, 1fr)); } .intro { grid-column: 1 / -1; } }
  @media (max-width: 520px) { .top { grid-template-columns: minmax(0, 1fr); } }
  .logo { width: 132px; margin-bottom: 18px; }
  .intro p { color: var(--on-dark-muted); max-width: 40ch; }
  .mail { margin-top: 14px; }
  .fh { font: 500 var(--t-xs)/1.2 var(--f-mono); letter-spacing: .09em; text-transform: uppercase; color: var(--on-dark-muted); margin-bottom: 14px; font-stretch: 100%; }
  ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 4px; }
  li a, .offices a { color: var(--on-dark) !important; text-decoration: none; display: inline-flex; min-height: 32px; align-items: center; }
  li a:hover, .offices a:hover { color: #fff !important; text-decoration: underline; }
  address { font-style: normal; color: var(--on-dark-muted); line-height: 1.6; }
  address + address { margin-top: 18px; }
  address strong { color: var(--on-dark); font-weight: 600; }
  .group { padding-block: 24px; }
  .group ul { display: flex; flex-wrap: wrap; gap: 4px 22px; }
  .legal { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 12px 24px; padding: 24px clamp(4px, 2vw, 24px) 0; color: var(--on-dark-muted); font-size: var(--t-xs); }
  .legal ul { display: flex; flex-wrap: wrap; gap: 4px 20px; }
</style>
