---
// Brand graphic built from the logo's hexagon. Purely decorative.
interface Props { variant?: 'dark' | 'light'; class?: string }
const { variant = 'dark', class: cls = '' } = Astro.props;
const id = `hx-${Math.random().toString(36).slice(2, 8)}`;
// Pointy-top hexagon path centred on (0,0) with radius r
const hex = (r: number) => {
  const pts = Array.from({ length: 6 }, (_, i) => {
    const a = (Math.PI / 3) * i - Math.PI / 2;
    return `${(r * Math.cos(a)).toFixed(1)},${(r * Math.sin(a)).toFixed(1)}`;
  });
  return `M${pts.join('L')}Z`;
};
const cells = [
  { x: 420, y: 230, r: 150, w: 2.2, o: 0.9, s: 'a' },
  { x: 260, y: 380, r: 70, w: 1.6, o: 0.55, s: 'b' },
  { x: 560, y: 470, r: 52, w: 1.4, o: 0.5, s: 'c' },
  { x: 600, y: 120, r: 36, w: 1.2, o: 0.45, s: 'b' },
  { x: 160, y: 180, r: 26, w: 1, o: 0.4, s: 'c' },
  { x: 420, y: 230, r: 104, w: 1, o: 0.35, s: 'a' },
];
---
<svg class={`hexfield hf-${variant} ${cls}`} viewBox="0 0 700 560" fill="none" aria-hidden="true" focusable="false" data-loop>
  <defs>
    <linearGradient id={`${id}-g`} x1="0" y1="0" x2="1" y2="1">
      <stop offset="0" stop-color="#2583DB" />
      <stop offset=".5" stop-color="#16A3B0" />
      <stop offset="1" stop-color="#1FA92F" />
    </linearGradient>
  </defs>
  {cells.map((c, i) => (
    <g class={`cell cell-${c.s}`} style={`--d:${i * 1.3}s`} transform={`translate(${c.x} ${c.y})`}>
      <path d={hex(c.r)} stroke={`url(#${id}-g)`} stroke-width={c.w} opacity={c.o} fill="none" />
    </g>
  ))}
</svg>
<style>
  .hexfield { position: absolute; pointer-events: none; z-index: -1; }
  .hexfield.hf-light { opacity: .6; }
  .cell { transform-box: fill-box; transform-origin: center; }
  @media (prefers-reduced-motion: no-preference) {
    .cell-a path { animation: spin 60s linear infinite; transform-box: fill-box; transform-origin: center; }
    .cell-b { animation: float 9s ease-in-out infinite; animation-delay: var(--d); }
    .cell-c { animation: float 12s ease-in-out infinite reverse; animation-delay: var(--d); }
  }
  @keyframes spin { to { rotate: 360deg; } }
  @keyframes float { 0%, 100% { translate: 0 0; } 50% { translate: 0 -14px; } }
</style>
