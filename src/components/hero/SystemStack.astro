---
// Homepage hero visual: how Moksh AI turns business information into finished
// work. Five isometric layers, read top to bottom: your systems, business
// context, the AI agent, human review, business outcomes.
//
// Static SVG + HTML, so the headline never waits for it. A small script then
// brings it to life: the stack compacts into the AI core and explodes back out
// on a loop, tilts towards the pointer, spreads further on hover, and lifts
// the layer you point at. Everything moves with transforms only (CLS 0),
// pauses off screen and in background tabs, and stays still under
// prefers-reduced-motion (the exploded view is the resting state).

const W = 460;
const H = 640;
const CX = 222;
const T = 14; // plate thickness

interface Layer { n: string; key: string; title: string; short: string; items: string; cy: number; w: number }
const layers: Layer[] = [
  { n: '01', key: 'systems', title: 'Your business systems', short: 'Systems', items: 'Email, documents, CRM, ERP, helpdesk', cy: 72, w: 300 },
  { n: '02', key: 'context', title: 'Business context', short: 'Context', items: 'Knowledge, customer information, operational data', cy: 178, w: 300 },
  { n: '03', key: 'ai', title: 'Moksh AI agent', short: 'AI agent', items: 'Understands, reasons, classifies and prepares the decision', cy: 322, w: 336 },
  { n: '04', key: 'human', title: 'Human review', short: 'Human review', items: 'Approval, validation, exceptions and escalation', cy: 448, w: 300 },
  { n: '05', key: 'outcomes', title: 'Business outcomes', short: 'Outcomes', items: 'Updated records, finished workflows, notifications, reports', cy: 552, w: 300 },
];
const AI_CY = layers[2].cy;
// Compact positions: every layer pulled most of the way into the AI layer.
const compactCy = layers.map((l) => AI_CY + (l.cy - AI_CY) * 0.3);

const pts = (p: [number, number][]) => p.map(([x, y]) => `${x.toFixed(1)},${y.toFixed(1)}`).join(' ');
function plate(cy: number, w: number) {
  const hw = w / 2, hh = w / 4;
  return {
    top: pts([[CX, cy - hh], [CX + hw, cy], [CX, cy + hh], [CX - hw, cy]]),
    left: pts([[CX - hw, cy], [CX, cy + hh], [CX, cy + hh + T], [CX - hw, cy + T]]),
    right: pts([[CX, cy + hh], [CX + hw, cy], [CX + hw, cy + T], [CX, cy + hh + T]]),
    rim: `M${CX - hw + 3} ${cy} L${CX} ${cy - hh + 1.5} L${CX + hw - 3} ${cy}`, // back edges catch the light
    front: `M${CX - hw} ${cy} L${CX} ${cy + hh} L${CX + hw} ${cy}`,
  };
}
function block(x: number, y: number, s: number, d: number) {
  return {
    top: pts([[x, y - s / 2], [x + s, y], [x, y + s / 2], [x - s, y]]),
    left: pts([[x - s, y], [x, y + s / 2], [x, y + s / 2 + d], [x - s, y + d]]),
    right: pts([[x, y + s / 2], [x + s, y], [x + s, y + d], [x, y + s / 2 + d]]),
    rim: `M${x - s + 1} ${y} L${x} ${y - s / 2 + .6} L${x + s - 1} ${y}`,
  };
}
const onPlate = (l: Layer, u: number, v: number): [number, number] => [CX - (l.w / 2) * u + (l.w / 2) * v, l.cy + (l.w / 4) * (u + v)];

const spots: Record<string, [number, number][]> = {
  systems: [[0.55, 0.05], [0.3, 0.3], [0.05, 0.55], [0.62, 0.32], [0.32, 0.62]],
  context: [[0.45, 0.15], [0.15, 0.45], [0.48, 0.48]],
  ai: [],
  human: [[0.42, 0.22], [0.22, 0.42]],
  outcomes: [[0.5, 0.12], [0.3, 0.32], [0.12, 0.5], [0.55, 0.45]],
};

// Connectors rise from each plate to the one above it. They belong to the
// lower plate, so they move with it; the script scales their length to the gap.
function connectorsUp(i: number) {
  if (i === 0) return [];
  const lo = layers[i], up = layers[i - 1];
  const xs = lo.key === 'ai' ? [-74, 74] : up.key === 'ai' ? [-64, 64] : [-56, 0, 56];
  const top = up.cy + up.w / 4 - 30; // reaches under the upper plate
  return xs.map((dx) => ({ x: CX + dx, y1: lo.cy + 4, y2: top }));
}

const core = { x: CX, y: AI_CY - 18, r: 40 };
const hex = (cx: number, cy: number, r: number) =>
  pts(Array.from({ length: 6 }, (_, k) => { const a = Math.PI / 2 + (k * Math.PI) / 3; return [cx + r * Math.cos(a), cy - r * Math.sin(a)] as [number, number]; }));

const drawOrder = layers.map((l, i) => ({ l, i })).reverse(); // bottom of the screen first
const geometry = JSON.stringify({ exploded: layers.map((l) => l.cy), compact: compactCy, height: H });
---
<figure class="sys" data-sys data-geometry={geometry} data-loop>
  <div class="sys-tilt">
    <svg class="sys-svg" viewBox={`0 0 ${W} ${H}`} aria-hidden="true" focusable="false">
      <defs>
        <linearGradient id="sx-top" x1="0" y1="0" x2="1" y2="1"><stop offset="0" class="s-paper-hi" /><stop offset="1" class="s-paper-lo" /></linearGradient>
        <linearGradient id="sx-left" x1="0" y1="0" x2="0" y2="1"><stop offset="0" class="s-side-a" /><stop offset="1" class="s-side-b" /></linearGradient>
        <linearGradient id="sx-right" x1="0" y1="0" x2="0" y2="1"><stop offset="0" class="s-side-c" /><stop offset="1" class="s-side-d" /></linearGradient>
        <linearGradient id="sx-ai" x1="0" y1="0" x2="1" y2="1"><stop offset="0" class="s-blue" /><stop offset=".5" class="s-teal" /><stop offset="1" class="s-green" /></linearGradient>
        <linearGradient id="sx-ai-side" x1="0" y1="0" x2="0" y2="1"><stop offset="0" class="s-navy-a" /><stop offset="1" class="s-navy-b" /></linearGradient>
        <radialGradient id="sx-halo"><stop offset="0" class="s-halo" /><stop offset="1" class="s-halo-0" /></radialGradient>
        <filter id="sx-blur" x="-30%" y="-60%" width="160%" height="220%"><feGaussianBlur stdDeviation="9" /></filter>
        <filter id="sx-glow" x="-100%" y="-100%" width="300%" height="300%"><feGaussianBlur stdDeviation="2.2" result="b" /><feMerge><feMergeNode in="b" /><feMergeNode in="SourceGraphic" /></feMerge></filter>
      </defs>

      {drawOrder.map(({ l, i }) => {
        const p = plate(l.cy, l.w);
        return (
          <g class={`layer layer-${l.key}`} data-l={l.key} data-i={i}>
            <ellipse class="shadow" cx={CX} cy={l.cy + l.w / 4 + 30} rx={l.w * 0.36} ry={l.w * 0.09} filter="url(#sx-blur)" />
            <polygon class="side-l" points={p.left} />
            <polygon class="side-r" points={p.right} />
            <polygon class="top" points={p.top} />
            {l.key === 'ai' && <polygon class="tint" points={p.top} />}
            <polygon class="glow" points={p.top} />
            <path class="rim" d={p.rim} />
            <path class="edge" d={p.front} />
            {spots[l.key].map(([u, v], k) => {
              const [x, y] = onPlate(l, u, v);
              const flat = l.key === 'context';
              const b = block(x, y, flat ? 22 : 15, flat ? 4 + k * 3 : 12);
              return (
                <g class={`blk blk-${l.key}`} style={`--k:${k}`}>
                  <polygon class="b-l" points={b.left} />
                  <polygon class="b-r" points={b.right} />
                  <polygon class="b-t" points={b.top} />
                  <path class="b-rim" d={b.rim} />
                </g>
              );
            })}
            {l.key === 'ai' && (
              <g class="core">
                <ellipse cx={core.x} cy={AI_CY + 4} rx="122" ry="54" fill="url(#sx-halo)" class="halo" />
                <ellipse cx={core.x} cy={AI_CY + 2} rx="70" ry="30" class="ring" />
                <g class="core-float">
                  <polygon points={hex(core.x, core.y, core.r)} fill="url(#sx-ai)" class="core-hex" />
                  <polygon points={hex(core.x, core.y, core.r - 1.5)} class="core-rim" />
                  <rect x={core.x - 17} y={core.y - 17} width="34" height="34" rx="8" class="core-badge" />
                  <image href="/favicon.svg" x={core.x - 13} y={core.y - 13} width="26" height="26" />
                </g>
              </g>
            )}
            <g class="wires" data-wires={i}>
              {connectorsUp(i).map((c, k) => (
                <>
                  <path class="wire" d={`M${c.x} ${c.y1} L${c.x} ${c.y2}`} />
                  <path class="packet" d={`M${c.x} ${c.y2} L${c.x} ${c.y1}`} filter="url(#sx-glow)" style={`--d:${(k * 0.45 + i * 0.3).toFixed(2)}s`} />
                </>
              ))}
            </g>
            <path class="leader" d={`M${CX + l.w / 2 + 6} ${l.cy} H${W - 4}`} />
          </g>
        );
      })}
      <!-- while compacted, the AI core's light shines up through the stack -->
      <g class="beam">
        <ellipse cx={CX} cy={AI_CY - 40} rx="120" ry="150" fill="url(#sx-halo)" />
        <polygon points={hex(core.x, core.y, core.r * 0.62)} fill="url(#sx-ai)" class="beam-core" />
      </g>
    </svg>
  </div>

  <ol class="sys-labels" role="list" aria-label="How Moksh AI turns business information into finished work">
    {layers.map((l) => (
      <li class={`lbl lbl-${l.key}`} data-l={l.key} style={`top:${((l.cy / H) * 100).toFixed(2)}%`}>
        <span class="lbl-n mono" aria-hidden="true">{l.n}</span>
        <span class="lbl-t"><span class="lbl-long">{l.title}</span><span class="lbl-short" aria-hidden="true">{l.short}</span></span>
        <span class="lbl-i">{l.items}</span>
      </li>
    ))}
  </ol>
</figure>

<style>
  .sys { --rx: 0deg; --ry: 0deg; margin: 0; position: relative; width: 100%; aspect-ratio: 760 / 640; perspective: 1400px; }
  .sys-tilt { position: absolute; left: 0; top: 0; width: calc(100% * 460 / 760); height: 100%; transform: rotateX(var(--rx)) rotateY(var(--ry)); transform-style: preserve-3d; }
  .sys-svg { width: 100%; height: 100%; overflow: visible; }

  .layer { transform: translateY(calc(var(--dy, 0) * 1px)); }
  .wires { transform-box: fill-box; transform-origin: 50% 100%; transform: scaleY(var(--s, 1)); }

  /* gradients from tokens */
  .s-paper-hi { stop-color: var(--surface); } .s-paper-lo { stop-color: var(--paper); }
  .s-side-a { stop-color: var(--track); } .s-side-b { stop-color: var(--line-strong); }
  .s-side-c { stop-color: var(--line-strong); } .s-side-d { stop-color: var(--track); }
  .s-blue { stop-color: var(--blue); } .s-teal { stop-color: var(--teal); } .s-green { stop-color: var(--green); }
  .s-navy-a { stop-color: var(--ink-3); } .s-navy-b { stop-color: var(--ink-deep); }
  .s-halo { stop-color: var(--teal); stop-opacity: .4; } .s-halo-0 { stop-color: var(--teal); stop-opacity: 0; }

  /* plates: ceramic tops, soft sides, a lit back rim */
  .shadow { fill: var(--ink); opacity: .1; }
  .top { fill: url(#sx-top); stroke: var(--line-strong); stroke-width: .8; }
  .side-l { fill: url(#sx-left); }
  .side-r { fill: url(#sx-right); }
  .rim { fill: none; stroke: var(--surface); stroke-width: 1.6; stroke-linecap: round; }
  .edge { fill: none; stroke: var(--surface); stroke-width: .8; opacity: .8; }
  .glow { fill: var(--sky); stroke: var(--teal); stroke-width: 1.4; opacity: 0; transition: opacity .35s var(--ease); }

  /* the AI layer: tinted glass on a navy body */
  .layer-ai .top { stroke: var(--teal); stroke-width: 1.2; }
  .layer-ai .side-l, .layer-ai .side-r { fill: url(#sx-ai-side); }
  .tint { fill: url(#sx-ai); opacity: .2; transition: opacity .5s var(--ease); }
  .layer-ai .glow { fill: none; stroke-width: 2; }
  .layer-ai .rim { stroke: var(--teal-on-dark); }
  .layer-human .glow { stroke: var(--amber-on-dark); fill: var(--amber-soft); }
  .layer-outcomes .glow { stroke: var(--green); fill: var(--ok-soft); }

  /* modules on the plates */
  .blk .b-t { fill: var(--surface); stroke: var(--line-strong); stroke-width: .7; }
  .blk .b-l { fill: var(--track); }
  .blk .b-r { fill: var(--line-strong); }
  .b-rim { fill: none; stroke: var(--surface); stroke-width: 1; }
  .blk-systems .b-t { stroke: var(--blue); }
  .blk-context .b-t { fill: var(--sky); stroke: var(--teal); }
  .blk-human .b-t { fill: var(--amber-on-dark); stroke: var(--amber); }
  .blk-human .b-l { fill: var(--amber); opacity: .75; }
  .blk-human .b-r { fill: var(--amber); }
  .blk-outcomes .b-t { fill: var(--ok-soft); stroke: var(--green); }
  .blk-outcomes .b-l, .blk-outcomes .b-r { fill: var(--green-700); opacity: .6; }

  /* AI core */
  .core-hex { filter: drop-shadow(0 12px 20px rgba(11, 107, 114, .38)); }
  .core-rim { fill: none; stroke: var(--surface); stroke-opacity: .55; stroke-width: 1.2; }
  .core-badge { fill: var(--surface); }
  .ring { fill: none; stroke: var(--teal); stroke-width: 1.2; stroke-dasharray: 2 6; opacity: .55; }
  .halo { transition: opacity .5s var(--ease); }

  /* connectors and the packets that run down them */
  .wire { stroke: var(--teal); stroke-width: 1.2; stroke-dasharray: 2 6; stroke-linecap: round; fill: none; opacity: .55; }
  .packet { stroke: var(--teal); stroke-width: 2.4; stroke-linecap: round; fill: none; stroke-dasharray: 10 400; stroke-dashoffset: 10; opacity: 0; }
  .layer-human .wire, .layer-human .packet { stroke: var(--green); }
  .layer-outcomes .wire, .layer-outcomes .packet { stroke: var(--amber-on-dark); }
  .layer-ai .wire, .layer-ai .packet { stroke: var(--blue); }
  .leader { stroke: var(--line-strong); stroke-width: 1; stroke-dasharray: 2 4; fill: none; opacity: var(--lead, 1); transition: stroke .3s var(--ease); }
  .beam { opacity: var(--beam, 0); pointer-events: none; }
  .beam-core { opacity: .55; filter: blur(1px); }

  /* labels: real text, moved with the plates by the script */
  .sys-labels { list-style: none; margin: 0; padding: 0; position: absolute; left: calc(100% * 470 / 760); right: 0; top: 0; bottom: 0; }
  .lbl { position: absolute; left: 0; right: 0; transform: translateY(calc(-50% + var(--dyl, 0px))); display: grid; grid-template-columns: auto minmax(0, 1fr); column-gap: 10px; row-gap: 2px; align-items: baseline; padding: 6px 0 6px 10px; border-left: 2px solid transparent; cursor: default; transition: border-color .3s var(--ease); }
  .lbl-n { grid-row: span 2; font-size: var(--t-xs); color: var(--muted); }
  .lbl-t { font: 600 var(--t-sm)/1.25 var(--f-body); color: var(--ink); transition: color .25s var(--ease); }
  .lbl-i { font-size: var(--t-xs); line-height: 1.4; color: var(--muted); }
  .lbl-short { display: none; }
  .lbl-ai .lbl-t { font-size: var(--t-md); }
  .lbl-ai .lbl-n { color: var(--teal-700); }
  .lbl-human .lbl-n { color: var(--amber); }

  /* one layer in focus (pointer or the loop): it lights, the others recede */
  .sys[data-active] .layer:not(.is-on) .top { opacity: .78; }
  .sys[data-active] .layer:not(.is-on) .blk { opacity: .6; }
  .layer.is-on .glow { opacity: .9; }
  .layer.is-on .leader { stroke: var(--teal); }
  .lbl.is-on { border-left-color: var(--teal); }
  .lbl.is-on .lbl-t { color: var(--blue-700); }
  .lbl-human.is-on { border-left-color: var(--amber-on-dark); }
  .lbl-outcomes.is-on { border-left-color: var(--green); }
  .sys.is-compact .tint { opacity: .42; }
  .sys.is-compact .halo { opacity: 1.6; }

  @media (prefers-reduced-motion: no-preference) {
    .packet { animation: packet 2.4s var(--d, 0s) cubic-bezier(.4, 0, .6, 1) infinite; }
    .wire { animation: flow 1.6s linear infinite; }
    .core-float { animation: float 6s ease-in-out infinite; transform-box: fill-box; }
    .ring { animation: spin 18s linear infinite; transform-box: fill-box; transform-origin: center; }
  }
  @keyframes packet { 0% { stroke-dashoffset: 10; opacity: 0; } 12% { opacity: 1; } 80% { opacity: 1; } 100% { stroke-dashoffset: -260; opacity: 0; } }
  @keyframes flow { to { stroke-dashoffset: -16; } }
  @keyframes float { 50% { transform: translateY(-5px); } }
  @keyframes spin { to { transform: rotate(360deg); } }

  /* phones: shorter titles, no detail line */
  @media (max-width: 560px) {
    .sys { aspect-ratio: 640 / 640; }
    .sys-tilt { width: calc(100% * 460 / 640); }
    .sys-labels { left: calc(100% * 466 / 640); }
    .lbl { padding-left: 6px; }
    .lbl-i { display: none; }
    .lbl-long { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
    .lbl-short { display: inline; }
    .lbl-t, .lbl-ai .lbl-t { font-size: var(--t-xs); }
    .lbl-n { font-size: 11px; }
  }
</style>

<script>
  // Drives the stack: explode amount e (0 = compact, 1 = exploded, >1 = spread
  // on hover), pointer tilt, and which layer is in focus. Transforms only.
  const fig = document.querySelector<HTMLElement>('[data-sys]');
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (fig && !reduce) {
    const g = JSON.parse(fig.dataset.geometry || '{}') as { exploded: number[]; compact: number[]; height: number };
    const layers = Array.from(fig.querySelectorAll<SVGGElement>('.layer')).sort((a, b) => Number(a.dataset.i) - Number(b.dataset.i));
    const wires = layers.map((l) => l.querySelector<SVGGElement>('.wires'));
    const labels = Array.from(fig.querySelectorAll<HTMLElement>('.lbl'));
    const wireLen = wires.map((w) => (w && w.childElementCount ? w.getBBox().height : 0));
    const keys = layers.map((l) => l.dataset.l ?? '');
    const fine = matchMedia('(pointer: fine)').matches;

    let e = 1, eTarget = 1;
    let rx = 0, ry = 0, rxT = 0, ryT = 0;
    const lift = keys.map(() => 0), liftT = keys.map(() => 0);
    let hovering = false, focusKey: string | null = null, loopFocus = -1;
    let visible = true, raf = 0, last = performance.now();
    const timers: number[] = [];

    const setFocus = (key: string | null) => {
      if (key) fig.dataset.active = key; else delete fig.dataset.active;
      layers.forEach((l, i) => l.classList.toggle('is-on', keys[i] === key));
      labels.forEach((l) => l.classList.toggle('is-on', l.dataset.l === key));
      keys.forEach((k, i) => { liftT[i] = k === key && hovering ? -14 : 0; });
    };

    const frame = (now: number) => {
      const dt = Math.min(0.05, (now - last) / 1000); last = now;
      const k = 1 - Math.exp(-dt * 5);
      // Scrolling away from the hero folds the stack into the AI core.
      const hr = fig.getBoundingClientRect();
      const scrolled = Math.min(1, Math.max(0, (innerHeight * 0.32 - hr.top) / (hr.height * 0.9)));
      e += (Math.min(eTarget, 1 - 0.94 * scrolled) - e) * k;
      rx += (rxT - rx) * k; ry += (ryT - ry) * k;
      for (let i = 0; i < lift.length; i++) lift[i] += (liftT[i] - lift[i]) * k;
      const px = fig.clientHeight / g.height; // SVG unit -> CSS px for the labels
      const dys = layers.map((_, i) => (g.compact[i] - g.exploded[i]) * (1 - e) + lift[i]);
      layers.forEach((l, i) => {
        l.style.setProperty('--dy', dys[i].toFixed(2));
        // Labels hold their place while the stack compacts; they only follow the hover lift.
        if (labels[i]) labels[i].style.setProperty('--dyl', `${(lift[i] * px).toFixed(2)}px`);
        // Wires rise from this plate to the one above: keep their top under that plate.
        if (i > 0 && wires[i] && wireLen[i]) wires[i]!.style.setProperty('--s', Math.max(0, 1 + (dys[i] - dys[i - 1]) / wireLen[i]).toFixed(3));
      });
      fig.style.setProperty('--rx', `${rx.toFixed(2)}deg`);
      fig.style.setProperty('--ry', `${ry.toFixed(2)}deg`);
      fig.style.setProperty('--lead', Math.min(1, Math.max(0, (e - 0.55) / 0.4)).toFixed(3));
      fig.style.setProperty('--beam', Math.min(1, Math.max(0, (0.7 - e) / 0.6)).toFixed(3));
      fig.classList.toggle('is-compact', e < 0.45);
      raf = visible ? requestAnimationFrame(frame) : 0;
    };
    const start = () => { if (!raf && visible) { last = performance.now(); raf = requestAnimationFrame(frame); } };

    // The loop: compact into the AI layer ("processing"), explode back out,
    // then walk the focus down the five layers in order.
    const later = (fn: () => void, ms: number) => { timers.push(window.setTimeout(fn, ms)); };
    const cycle = () => {
      if (!hovering) {
        eTarget = 0.06;
        later(() => { if (!hovering) eTarget = 1; }, 1500);
        loopFocus = -1;
        const walk = () => {
          if (hovering) return;
          loopFocus++;
          if (loopFocus < keys.length) { setFocus(keys[loopFocus]); later(walk, 900); } else setFocus(null);
        };
        later(walk, 2300);
      }
      later(cycle, 9000);
    };
    later(cycle, 1600);

    if (fine) {
      fig.addEventListener('pointerenter', () => { hovering = true; eTarget = 1.14; setFocus(null); });
      fig.addEventListener('pointerleave', () => { hovering = false; eTarget = 1; rxT = 0; ryT = 0; setFocus(null); });
      fig.addEventListener('pointermove', (ev) => {
        const r = fig.getBoundingClientRect();
        const x = (ev.clientX - r.left) / r.width - 0.5, y = (ev.clientY - r.top) / r.height - 0.5;
        ryT = x * 10; rxT = -y * 7;
        const t = ev.target as Element;
        const key = t.closest<HTMLElement | SVGElement>('[data-l]')?.dataset.l ?? null;
        if (key !== focusKey) { focusKey = key; setFocus(key); }
      });
    }

    new IntersectionObserver(([en]) => { visible = en.isIntersecting && !document.hidden; if (visible) start(); }).observe(fig);
    document.addEventListener('visibilitychange', () => { visible = !document.hidden; if (visible) start(); });
    start();
  }
</script>
