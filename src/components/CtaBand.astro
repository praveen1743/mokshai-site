---
// Closing call to action. It sits on ink directly above the footer, so the
// two read as one dark area instead of two stacked panels.
import Arrow from './Arrow.astro';
interface Props { title?: string; text?: string; secondaryHref?: string; secondaryLabel?: string }
const {
  title = 'Book a 30-minute call about one workflow',
  text = 'Tell us which workflow takes up your team’s time. You get a straight answer on whether an agent fits, which systems it would touch, and how a pilot would be measured.',
  secondaryHref = '/tools/',
  secondaryLabel = 'Size it first with a calculator',
} = Astro.props;
---
<section class="cta-sec dark" aria-labelledby="cta-h">
  <div class="container cta">
    <div class="stack-sm">
      <span class="eyebrow">Next step</span>
      <h2 id="cta-h">{title}</h2>
      <p class="lede">{text}</p>
    </div>
    <div class="btn-row">
      <a class="btn btn-primary" href="/book/">Book a strategy call <Arrow /></a>
      <a class="btn btn-secondary" href={secondaryHref}>{secondaryLabel}</a>
    </div>
  </div>
</section>
<style>
  .cta-sec { padding-block: clamp(56px, 7vw, 88px) clamp(8px, 2vw, 16px); }
</style>
