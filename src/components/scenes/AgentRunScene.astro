---
// Homepage hero: one demo agent at work, per industry. Input → the agent's
// steps → what it flags → the person who signs off. Tabs switch industry;
// without JavaScript the first run is shown in full. Illustration only.
import Icon from '../Icon.astro';
import { agentBySlug } from '../../lib/agents';

const runs = [
  {
    id: 'claims', tab: 'Healthcare', agent: 'claims-automation',
    input: { icon: 'doc', text: 'Claim form · outpatient visit.pdf' },
    steps: ['Read the claim form', 'Extract patient, provider and treatment codes', 'Check the claim against policy rules'],
    result: { tone: 'wait', label: 'Flagged', text: 'Pre-authorisation missing' },
    person: 'Claims handler reviews and decides',
  },
  {
    id: 'legal', tab: 'Legal', agent: 'legal-document-review',
    input: { icon: 'doc', text: 'Master services agreement.pdf' },
    steps: ['Find key clauses, dates and obligations', 'Rate each finding by risk', 'Link every finding to its source text'],
    result: { tone: 'no', label: 'High risk', text: 'Uncapped liability · clause 11.2' },
    person: 'Lawyer checks and signs off',
  },
  {
    id: 'finance', tab: 'Finance', agent: 'financial-reasoning',
    input: { icon: 'chart', text: 'Analyst request: review one ticker' },
    steps: ['Pull prices, financials and filings', 'Summarise news sentiment', 'Draft structured reasoning and risks'],
    result: { tone: 'info', label: 'Ready', text: 'Notes drafted, two risks flagged' },
    person: 'Analyst makes the call',
  },
  {
    id: 'ops', tab: 'Operations', agent: 'email-meeting-assistant',
    input: { icon: 'inbox', text: '"Can we meet this week about the rollout?"' },
    steps: ['Read the thread and past emails', 'Find a slot free in both calendars', 'Draft the reply and the agenda'],
    result: { tone: 'ok', label: 'Drafted', text: 'Reply ready, Thursday 10:00 held' },
    person: 'You review and send',
  },
].map((r) => ({ ...r, name: agentBySlug(r.agent)?.name ?? '' }));
---
<figure class="scene run" aria-label="Illustration: a demo agent working through a task and handing the decision to a person">
  <div class="scene-bar">
    <span class="scene-title">Agent at work</span>
    <span class="scene-tag">Illustrative</span>
  </div>
  <div class="tabs" role="tablist" aria-label="Choose an industry">
    {runs.map((r, i) => (
      <button type="button" role="tab" id={`run-tab-${r.id}`} aria-controls={`run-${r.id}`} aria-selected={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? 0 : -1}>{r.tab}</button>
    ))}
  </div>
  {runs.map((r, i) => (
    <div class="panel" role="tabpanel" id={`run-${r.id}`} aria-labelledby={`run-tab-${r.id}`} hidden={i !== 0}>
      <p class="agent-name"><span class="hexi sm"><Icon name="copilot" /></span>{r.name}</p>
      <div class="in"><Icon name={r.input.icon} /><span>{r.input.text}</span></div>
      <ol class="steps-run" role="list">
        {r.steps.map((s) => (<li><span class="tick" aria-hidden="true"></span>{s}</li>))}
      </ol>
      <div class="out"><span class={`pill pill-${r.result.tone}`}>{r.result.label}</span><span>{r.result.text}</span></div>
      <div class="person"><span class="hexi sm human"><Icon name="shield" /></span><span><strong>{r.person}</strong><small>Nothing goes out until a person approves</small></span></div>
    </div>
  ))}
  <a class="run-link" href="/agents/">See all demo agents <span aria-hidden="true">→</span></a>
</figure>

<style>
  .run { background: var(--surface); }
  .tabs { display: flex; gap: 4px; padding: 10px 12px 0; border-bottom: 1px solid var(--line); overflow-x: auto; }
  .tabs button { flex: none; min-height: 40px; padding: 8px 14px; border: 0; border-bottom: 2px solid transparent; background: transparent; color: var(--muted); font: 500 var(--t-sm)/1 var(--f-body); cursor: pointer; }
  .tabs button:hover { color: var(--ink); }
  @media (max-width: 480px) { .tabs { padding-inline: 6px; gap: 0; } .tabs button { flex: 1; padding: 8px 6px; font-size: var(--t-xs); } }
  .tabs button[aria-selected='true'] { color: var(--ink); border-bottom-color: var(--teal); }
  .panel { padding: 18px; display: grid; gap: 14px; }
  .agent-name { display: flex; align-items: center; gap: 10px; font-weight: 600; }
  .in { display: flex; align-items: center; gap: 10px; padding: 12px 14px; border-radius: 10px; border: 1px dashed var(--line-strong); font-size: 13.5px; color: var(--muted); }
  .in :global(svg) { width: 18px; height: 18px; flex: none; color: var(--blue-700); }
  .steps-run { list-style: none; margin: 0; padding: 0 0 0 6px; display: grid; gap: 10px; border-left: 2px solid var(--line); }
  .steps-run li { display: flex; align-items: center; gap: 10px; font-size: 13.5px; padding-left: 12px; position: relative; }
  .tick { width: 16px; height: 16px; border-radius: 50%; background: var(--ok-soft); flex: none; position: relative; }
  .tick::after { content: ""; position: absolute; left: 5px; top: 3px; width: 4px; height: 7px; border: solid var(--ok); border-width: 0 2px 2px 0; transform: rotate(45deg); }
  @media (prefers-reduced-motion: no-preference) {
    .panel:not([hidden]) .steps-run li { animation: step-in .4s var(--ease) both; }
    .panel:not([hidden]) .steps-run li:nth-child(2) { animation-delay: .12s; }
    .panel:not([hidden]) .steps-run li:nth-child(3) { animation-delay: .24s; }
    @keyframes step-in { from { transform: translateX(-6px); } }
  }
  .out { display: flex; flex-wrap: wrap; align-items: center; gap: 10px; padding: 12px 14px; border-radius: 10px; background: var(--sky); font-size: 13.5px; font-weight: 500; }
  .person { display: flex; align-items: center; gap: 12px; padding-top: 14px; border-top: 1px solid var(--line); }
  .person span:last-child { display: grid; gap: 2px; font-size: 13.5px; }
  .person small { color: var(--muted); font-size: 12px; }
  .hexi.human { background: linear-gradient(140deg, var(--amber-on-dark), var(--amber)); color: var(--ink-deep); }
  .run-link { display: block; padding: 12px 18px; border-top: 1px solid var(--line); font: 500 var(--t-xs)/1.4 var(--f-mono); letter-spacing: .05em; text-transform: uppercase; color: var(--blue-700); text-decoration: none; }
  .run-link:hover { color: var(--teal-700); }
</style>

<script>
  // Tabs with arrow-key support (WAI-ARIA tabs pattern, manual activation on click/Enter).
  document.querySelectorAll<HTMLElement>('.run [role="tablist"]').forEach((list) => {
    const tabs = Array.from(list.querySelectorAll<HTMLButtonElement>('[role="tab"]'));
    const select = (t: HTMLButtonElement) => {
      tabs.forEach((x) => {
        const on = x === t;
        x.setAttribute('aria-selected', String(on));
        x.tabIndex = on ? 0 : -1;
        const panel = document.getElementById(x.getAttribute('aria-controls') ?? '');
        if (panel) panel.hidden = !on;
      });
    };
    tabs.forEach((t, i) => {
      t.addEventListener('click', () => select(t));
      t.addEventListener('keydown', (e) => {
        const k = e.key;
        let n = -1;
        if (k === 'ArrowRight') n = (i + 1) % tabs.length;
        else if (k === 'ArrowLeft') n = (i - 1 + tabs.length) % tabs.length;
        else if (k === 'Home') n = 0;
        else if (k === 'End') n = tabs.length - 1;
        if (n < 0) return;
        e.preventDefault();
        tabs[n].focus();
        select(tabs[n]);
      });
    });
  });
</script>
