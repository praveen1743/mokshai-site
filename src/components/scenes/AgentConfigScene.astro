  <div class="scene-bar"><span class="scene-title">agents/tier1-triage.yaml</span><span class="scene-tag">Illustrative</span></div>
  <pre class="code" tabindex="0" role="region" aria-label="Agent definition (scrolls sideways)"><code><span class="k">agent</span>: <span class="v">tier1-triage</span>
<span class="k">reads</span>:  [<span class="s">psa.tickets</span>, <span class="s">rmm.devices</span>, <span class="s">kb.articles</span>]
<span class="k">writes</span>: [<span class="s">psa.tickets.notes</span>, <span class="s">psa.tickets.category</span>]
<span class="k">actions</span>:
  <span class="k">password_reset</span>:  <span class="ok">auto</span>       <span class="c"># identity verified first</span>
  <span class="k">access_request</span>:  <span class="wait">approve</span>    <span class="c"># manager signs off</span>
  <span class="k">firewall_change</span>: <span class="no">never</span>      <span class="c"># always a person</span>
<span class="k">escalate_when</span>:
  - <span class="v">confidence &lt; 0.85</span>
  - <span class="v">client.tier == "priority"</span>
<span class="k">log</span>: <span class="v">every_action</span></code></pre>
