---
const rows = [
  { t: 'Chat assistant A', now: 1200, after: 660 },
  { t: 'Chat assistant B', now: 375, after: 0 },
  { t: 'Meeting notes', now: 450, after: 162 },
  { t: 'Writing assistant', now: 200, after: 200 },
];
const max = 1200;
const total = rows.reduce((s, r) => s + r.now, 0);
const after = rows.reduce((s, r) => s + r.after, 0);
---
<figure class="scene spend" aria-label="Illustration: AI subscription spend before and after right-sizing">
  <div class="scene-bar"><span class="scene-title">AI subscriptions · monthly</span><span class="scene-tag">Illustrative</span></div>
  <div class="scene-body">
    <div class="legend mono"><span><i class="now"></i>Today</span><span><i class="aft"></i>After review</span></div>
    <ul class="rows" role="list">
      {rows.map((r) => (
        <li>
          <span class="rt">{r.t}</span>
          <span class="bars">
            <span class="b now" style={`width:${(r.now / max) * 100}%`}></span>
            <span class="b aft" style={`width:${Math.max(1, (r.after / max) * 100)}%`}></span>
          </span>
          <span class="mono rv">${r.now.toLocaleString('en-US')} → ${r.after.toLocaleString('en-US')}</span>
        </li>
      ))}
    </ul>
    <div class="sum">
      <div><span class="mono lbl">Today</span><strong class="mono">${total.toLocaleString('en-US')}</strong></div>
      <div><span class="mono lbl">After</span><strong class="mono">${after.toLocaleString('en-US')}</strong></div>
      <div class="save"><span class="mono lbl">Saved / year</span><strong class="mono save-v">${((total - after) * 12).toLocaleString('en-US')}</strong></div>
    </div>
  </div>
</figure>
<style>
  .legend { display: flex; gap: 16px; font-size: 11.5px; color: var(--muted); }
  .legend span { display: inline-flex; align-items: center; gap: 6px; }
  .legend i { width: 14px; height: 8px; border-radius: 4px; display: inline-block; }
  i.now, .b.now { background: #c9d6df; } i.aft, .b.aft { background: var(--grad); }
  .rows { list-style: none; margin: 0; padding: 0; display: grid; gap: 14px; }
  .rows li { display: grid; grid-template-columns: 120px 1fr auto; gap: 12px; align-items: center; }
  .rt { font-size: 13px; font-weight: 500; }
  .bars { display: grid; gap: 4px; }
  .b { display: block; height: 8px; border-radius: 99px; }
  .rv { font-size: 12px; color: var(--muted); white-space: nowrap; }
  .sum { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 10px; border-top: 1px dashed var(--line-strong); padding-top: 14px; }
  .sum div { display: grid; gap: 4px; }
  .lbl { font-size: 10.5px; letter-spacing: .07em; text-transform: uppercase; color: var(--muted); }
  .sum strong { font-size: 20px; }
  .save-v { color: var(--green-700); }
  @media (max-width: 480px) { .rows li { grid-template-columns: 1fr auto; } .bars { grid-column: 1 / -1; grid-row: 2; } }
</style>
