---
// LLM integration: an in-product document Q&A answer grounded in cited sources.
const sources = ['Returns-policy-2026.pdf · p.3', 'Help centre · Refund timelines', 'Order #A-1182 history'];
---
<figure class="scene rag" aria-label="Illustration: an AI answer inside a product, grounded in cited source documents">
  <div class="scene-bar"><span class="scene-title">Your app · AI answer</span><span class="scene-tag">Illustrative</span></div>
  <div class="scene-body">
    <p class="q">Can this customer still return order A-1182?</p>
    <div class="a">
      <p>Yes. The order was delivered within the return window and the item is in a returnable category. A refund goes back to the original payment method once the item is received.</p>
      <ul class="src" role="list">{sources.map((s, i) => (<li><span class="n mono">{i + 1}</span>{s}</li>))}</ul>
    </div>
    <div class="meta"><span class="pill pill-info">Grounded in 3 sources</span><span class="pill pill-ok">PII filtered</span></div>
  </div>
</figure>
<style>
  .q { justify-self: end; max-width: 85%; padding: 10px 12px; border-radius: 12px; background: var(--sky); border: 1px solid var(--line); font-size: 13px; font-weight: 500; }
  .a { display: grid; gap: 10px; padding: 12px; border-radius: 12px; border: 1px solid var(--line); font-size: 13px; }
  .src { list-style: none; margin: 0; padding: 10px 0 0; border-top: 1px dashed var(--line-strong); display: grid; gap: 6px; font-size: 12px; color: var(--muted); }
  .src li { display: flex; gap: 8px; align-items: center; }
  .n { width: 18px; height: 18px; border-radius: 50%; display: grid; place-items: center; font-size: 10.5px; background: var(--surface); border: 1px solid var(--line-strong); color: var(--blue-700); }
  .meta { display: flex; flex-wrap: wrap; gap: 8px; }
</style>
