---
// Homepage hero visual when a Spline scene is configured (site.heroSpline).
// Desktop with a mouse: the live, cursor-following scene, loaded after first
// paint. Phones, reduced motion, data saver or no WebGL: the poster image only.
import { site } from '../../site.config';
const { scene, poster } = site.heroSpline;
---
<figure class="hero-spline" data-hero-spline data-scene={scene} data-loop aria-label="Illustration: the Moksh AI agent, a robot in the Moksh colours that turns to follow your cursor.">
  <div class="hs-stage">
    <img class="hs-poster" src={poster} alt="" width="1200" height="1200" decoding="async" />
    <canvas class="hs-canvas" aria-hidden="true"></canvas>
  </div>
  <figcaption class="hs-credit"><a href="https://spline.design" rel="noopener" target="_blank">Made with Spline</a></figcaption>
</figure>

<style>
  .hero-spline { margin: 0; position: relative; }
  .hs-stage { position: relative; aspect-ratio: 1 / 1; width: 100%; }
  @media (max-width: 760px) { .hs-stage { aspect-ratio: 4 / 3; } }
  .hs-poster, .hs-canvas { position: absolute; inset: 0; width: 100%; height: 100%; }
  .hs-poster { object-fit: contain; }
  .hs-canvas { display: none; }
  .hero-spline:global(.is-live) .hs-canvas { display: block; }
  .hero-spline:global(.is-live) .hs-poster { display: none; }
  .hs-credit { position: absolute; right: 8px; bottom: 6px; font: 400 10.5px/1 var(--f-mono); letter-spacing: .04em; }
  .hs-credit a { color: var(--on-dark-muted); text-decoration: none; }
  .hs-credit a:hover { color: var(--on-dark); }
</style>

<script>
  // Live scene only where it pays off: a fine pointer to follow, motion allowed,
  // no data saver, WebGL available. Everyone else keeps the poster.
  const root = document.querySelector<HTMLElement>('[data-hero-spline]');
  const conn = (navigator as Navigator & { connection?: { saveData?: boolean } }).connection;
  const ok = !!root?.dataset.scene
    && matchMedia('(pointer: fine) and (min-width: 761px)').matches
    && !matchMedia('(prefers-reduced-motion: reduce)').matches
    && !conn?.saveData
    && (() => { try { const c = document.createElement('canvas'); return !!(c.getContext('webgl2') || c.getContext('webgl')); } catch { return false; } })();

  if (root && ok) {
    const start = async () => {
      const canvas = root.querySelector<HTMLCanvasElement>('.hs-canvas')!;
      const { Application } = await import('@splinetool/runtime');
      // WebGL keeps one backend for the whole page and matches what we test.
      const app = new Application(canvas, { wasmPath: '/spline/', renderer: 'webgl' });
      await app.load(root.dataset.scene!);
      // Follow the cursor anywhere on the page, not only over the canvas.
      app.setGlobalEvents(true);
      root.classList.add('is-live');
      // Pause rendering, controls and events while the hero is off screen.
      new IntersectionObserver(([e]) => (e.isIntersecting ? app.play() : app.stop())).observe(root);
      document.addEventListener('visibilitychange', () => (document.hidden ? app.stop() : app.play()));
    };
    const go = () => start().catch(() => { /* keep the poster */ });
    if ('requestIdleCallback' in window) requestIdleCallback(go, { timeout: 1500 }); else setTimeout(go, 400);
  }
</script>
